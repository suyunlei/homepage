---
import { render, type CollectionEntry } from 'astro:content';
import { withBase } from '@/lib/paths';

interface Props {
  publication: CollectionEntry<'publications'>;
}

const { publication } = Astro.props;
const { data } = publication;
const { Content } = await render(publication);

const typeLabels: Record<string, string> = {
  journal: 'Journal',
  conference: 'Conference',
  preprint: 'Preprint',
  thesis: 'Thesis',
};

const searchHaystack = [
  data.title,
  data.titleZh,
  data.venue,
  String(data.year),
  data.authors.join(' '),
  data.keywords.join(' '),
  data.indexing.join(' '),
]
  .join(' ')
  .toLowerCase();
---

<article
  class="pub-card editorial-card rounded-2xl p-6 transition-colors hover:border-[#252528]/35 sm:p-7"
  data-pub-type={data.type}
  data-pub-year={String(data.year)}
  data-pub-search={searchHaystack}
>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
      <span class="rounded-full bg-[#252528] px-2.5 py-0.5 text-[#f4f6f8]">{data.year}</span>
      <span class="rounded-full border border-[#252528]/25 px-2.5 py-0.5 text-[#252528]">
        {typeLabels[data.type] ?? data.type}
      </span>
      {
        data.indexing.map((badge) => (
          <span class="rounded-full bg-[#27445d]/12 px-2.5 py-0.5 font-medium text-[#27445d]">
            {badge}
          </span>
        ))
      }
    </div>
    <span class="font-mono text-xs text-[#5d636c]">{data.venue}</span>
  </div>

  <h3 class="mt-4 text-lg font-semibold leading-snug text-[#252528] sm:text-xl">
    {data.title}
  </h3>

  {
    data.titleZh && (
      <p class="mt-1 text-sm text-[#4a4f57]">{data.titleZh}</p>
    )
  }

  <p class="mt-3 text-sm leading-relaxed text-[#252528]">
    {
      data.authors.map((author, idx) => {
        const isSelf = author.toLowerCase().includes(data.highlightAuthor.toLowerCase());
        return (
          <>
            {idx > 0 && ', '}
            {isSelf ? (
              <strong class="font-semibold underline decoration-[#27445d]/60 underline-offset-4">
                {author}
              </strong>
            ) : (
              <span>{author}</span>
            )}
          </>
        );
      })
    }
  </p>

  {
    data.authorNote && (
      <p class="mt-1 font-mono text-[11px] text-[#5d636c]">{data.authorNote}</p>
    )
  }

  {
    data.keywords.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {data.keywords.map((kw) => (
          <span class="rounded-md bg-[#252528]/[0.06] px-2 py-0.5 font-mono text-[11px] text-[#4a4f57]">
            {kw}
          </span>
        ))}
      </div>
    )
  }

  <div class="mt-5 flex flex-wrap items-center gap-2.5">
    <button
      type="button"
      class="editorial-pill cursor-pointer hover:border-[#252528]"
      data-toggle-drawer="abstract"
      aria-expanded="false"
    >
      Abstract & Highlights
    </button>

    {
      data.bibtex && (
        <button
          type="button"
          class="editorial-pill cursor-pointer hover:border-[#252528]"
          data-toggle-drawer="bibtex"
          aria-expanded="false"
        >
          BibTeX
        </button>
      )
    }

    {
      data.pdf && (
        <a
          href={withBase(data.pdf)}
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-pill bg-[#27445d] text-[#f4f6f8] border-[#27445d] hover:bg-[#1b3144]"
        >
          PDF ↗
        </a>
      )
    }

    {
      data.doi && (
        <a
          href={data.doi}
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-pill hover:border-[#252528]"
        >
          DOI ↗
        </a>
      )
    }

    {
      data.code && (
        <a
          href={data.code}
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-pill hover:border-[#252528]"
        >
          Code ↗
        </a>
      )
    }

    {
      data.dataset && (
        <a
          href={data.dataset}
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-pill hover:border-[#252528]"
        >
          Dataset ↗
        </a>
      )
    }
  </div>

  <!-- Abstract & Highlights Drawer -->
  <div class="pub-drawer mt-4 hidden border-t editorial-hairline pt-4" data-drawer="abstract">
    <p class="text-sm leading-relaxed text-[#252528]/90">{data.abstract}</p>
    <div class="prose-academic mt-3">
      <Content />
    </div>
  </div>

  <!-- BibTeX Drawer -->
  {
    data.bibtex && (
      <div class="pub-drawer mt-4 hidden border-t editorial-hairline pt-4" data-drawer="bibtex">
        <div class="flex items-center justify-between gap-2 pb-2">
          <span class="font-mono text-xs uppercase tracking-wider text-[#4a4f57]">
            BibTeX Citation
          </span>
          <button
            type="button"
            class="editorial-pill cursor-pointer hover:border-[#252528]"
            data-copy-bibtex
          >
            Copy BibTeX
          </button>
        </div>
        <pre class="overflow-x-auto rounded-xl bg-[#252528] p-4 font-mono text-xs leading-relaxed text-[#e6eaee]">{data.bibtex.trim()}</pre>
      </div>
    )
  }
</article>
