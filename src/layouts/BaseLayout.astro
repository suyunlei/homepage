---
import '@/styles/global.css';
import CustomCursor from '@/components/CustomCursor.astro';

interface Props {
  title: string;
  titleEn?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  titleEn = title,
  description = '苏云雷（Yunlei Su）个人主页 · 学术成果、WebGIS 与城市数字孪生研究、实践项目与播客记录。',
  bodyClass = '',
} = Astro.props;

const faviconSvg = encodeURIComponent(
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="14" fill="#252528"/><text x="50%" y="54%" dominant-baseline="middle" text-anchor="middle" fill="#afb6bc" font-family="sans-serif" font-weight="700" font-size="28">RS</text></svg>`,
);
---

<!doctype html>
<html lang="zh-CN" data-lang="zh" data-title-zh={title} data-title-en={titleEn}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`data:image/svg+xml,${faviconSvg}`} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var params = new URLSearchParams(window.location.search);
          var qLang = params.get('lang');
          var lang = qLang === 'en' || qLang === 'zh' ? qLang : (localStorage.getItem('site-lang') || 'zh');
          if (qLang === 'en' || qLang === 'zh') {
            localStorage.setItem('site-lang', qLang);
          }
          var root = document.documentElement;
          root.dataset.lang = lang === 'en' ? 'en' : 'zh';
          root.lang = lang === 'en' ? 'en' : 'zh-CN';
          var targetTitle = lang === 'en' ? root.dataset.titleEn : root.dataset.titleZh;
          if (targetTitle) document.title = targetTitle;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
    <CustomCursor />
  </body>
</html>
