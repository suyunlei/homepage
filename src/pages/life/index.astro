---
import { getCollection } from 'astro:content';
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import BiText from '@/components/BiText.astro';
import { getAlbumSlug, withBase } from '@/lib/paths';

const albums = (await getCollection('albums')).sort((a, b) => a.data.order - b.data.order);
const initialCover = albums[0] ? withBase(albums[0].data.cover) : '';
---

<EditorialLayout
  title="生活碎片 · Life Style · 苏云雷"
  titleEn="Life & Photography · Yunlei Su"
  description="生活碎片与摄影故事集：朋友们、篮球与青春、杭州光影、安徽大学校园四年，以及伦敦、日本与新加坡旅途。"
>
  <div class="relative overflow-hidden">
    <!-- Ambient grayscale backdrop echoing original CameraHome -->
    <div
      id="life-ambient-bg"
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10 bg-cover bg-center opacity-15 grayscale transition-all duration-700"
      style={initialCover ? `background-image: url('${initialCover}')` : undefined}
    />

    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
      <header class="reveal-section flex flex-wrap items-end justify-between gap-6 border-b editorial-hairline pb-8">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#4a4f57]">
            <BiText zh="Life Style · 艺术篇章与生活碎片" en="Life Style · Photo Stories" />
          </p>
          <h1 class="mt-2 text-3xl font-bold tracking-tight text-[#252528] sm:text-4xl">
            Life is full of Art
          </h1>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[#4a4f57] sm:text-base">
            <BiText
              zh="时间流逝得太快，许多事都记不清了。谨以这七个影集与篇章，留住走过的城市、老友、球场与远方。"
              en="Time moves fast. Seven curated chapters preserving friendships, basketball courts, Hangzhou, campus years at AHU, and journeys through London, Japan, and Singapore."
            />
          </p>
        </div>

        <div class="hidden items-center gap-2 md:flex">
          <button
            type="button"
            id="life-prev-btn"
            class="editorial-btn h-10 w-10 p-0"
            aria-label="向左滑动影集"
          >
            ←
          </button>
          <button
            type="button"
            id="life-next-btn"
            class="editorial-btn h-10 w-10 p-0"
            aria-label="向右滑动影集"
          >
            →
          </button>
        </div>
      </header>

      <section
        id="life-album-track"
        class="reveal-section mt-10 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-6 md:pb-8"
        aria-label="影集列表"
      >
        {
          albums.map((album, idx) => {
            const coverUrl = withBase(album.data.cover);
            return (
              <a
                href={withBase(`/life/${getAlbumSlug(album.id)}/`)}
                data-cover={coverUrl}
                class="life-album-card group relative flex min-h-[430px] w-[82vw] shrink-0 snap-start flex-col justify-between overflow-hidden rounded-2xl border border-[#252528]/20 bg-[#252528] p-6 text-[#f4f6f8] shadow-lg transition-transform duration-300 hover:-translate-y-1 sm:w-[340px] lg:w-[360px]"
              >
                <img
                  src={coverUrl}
                  alt={album.data.title}
                  loading={idx < 2 ? 'eager' : 'lazy'}
                  fetchpriority={idx === 0 ? 'high' : 'auto'}
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
                <div
                  aria-hidden="true"
                  class="absolute inset-0 bg-gradient-to-t from-[#19232c]/90 via-[#19232c]/35 to-[#19232c]/25 transition-opacity duration-300 group-hover:opacity-95"
                />

                <div class="relative z-10 flex items-center justify-between font-mono text-xs">
                  <span class="flex items-center gap-2 tracking-widest">
                    <span>{album.data.number}</span>
                    <span class="inline-block h-[1px] w-7 bg-white/70 transition-all duration-300 group-hover:w-10" />
                  </span>
                  <span class="rounded-full bg-white/15 px-2.5 py-0.5 text-[11px] backdrop-blur-sm">
                    {album.data.items.length} stories
                  </span>
                </div>

                <div class="relative z-10 space-y-2.5">
                  <p class="font-mono text-xs uppercase tracking-wider text-white/75">
                    {album.data.location}
                  </p>
                  <h2 class="text-2xl font-bold leading-tight tracking-tight text-white">
                    {album.data.headline}
                  </h2>
                  <p class="text-xs leading-relaxed text-white/80">
                    <BiText zh={album.data.description} en={album.data.descriptionEn || album.data.description} />
                  </p>
                  <div class="pt-2">
                    <span class="inline-flex items-center gap-2 rounded-full bg-[#27445d] px-3.5 py-1.5 font-mono text-xs text-white transition-colors group-hover:bg-white group-hover:text-[#252528]">
                      <span>Read the Story</span>
                      <span aria-hidden="true">→</span>
                    </span>
                  </div>
                </div>
              </a>
            );
          })
        }
      </section>

      <div class="mt-3 flex items-center justify-center gap-3 md:hidden" aria-label="影集滑动指示">
        <div class="flex items-center gap-1.5">
          {
            albums.map((album, idx) => (
              <button
                type="button"
                data-album-dot={idx}
                aria-label={`切换到第 ${idx + 1} 个影集 ${album.data.title}`}
                aria-pressed={idx === 0 ? 'true' : 'false'}
                class:list={[
                  'h-2 rounded-full transition-all duration-300',
                  idx === 0 ? 'w-6 bg-[#252528]' : 'w-2 bg-[#252528]/25',
                ]}
              />
            ))
          }
        </div>
        <span id="life-mobile-counter" class="font-mono text-[11px] text-[#4a4f57]">
          01 / {String(albums.length).padStart(2, '0')}
        </span>
      </div>
    </div>
  </div>

  <script>
    import '../../scripts/life-index';
  </script>
</EditorialLayout>
