---
import { getCollection } from 'astro:content';
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import BiText from '@/components/BiText.astro';
import { getAlbumSlug, getLifeThumbPath, toAvifPath, withBase } from '@/lib/paths';
import { getLqipDataUri } from '@/lib/lqip';

const albums = (await getCollection('albums')).sort((a, b) => a.data.order - b.data.order);
const initialCoverPath = albums[0] ? albums[0].data.cover : '';
const initialCover = initialCoverPath ? withBase(initialCoverPath) : '';
const initialCoverAvifPath = initialCoverPath ? toAvifPath(initialCoverPath) : '';
const initialCoverAvif =
  initialCoverAvifPath && initialCoverAvifPath !== initialCoverPath
    ? withBase(initialCoverAvifPath)
    : '';
const albumLqips = await Promise.all(albums.map((a) => getLqipDataUri(a.data.cover)));
---

<EditorialLayout
  title="生活碎片 · Life Style · 苏云雷"
  titleEn="Life & Photography · Yunlei Su"
  description="生活碎片与摄影故事集：朋友们、篮球与青春、杭州光影、安徽大学校园四年，以及伦敦、日本与新加坡旅途。"
>
  <div class="relative overflow-hidden">
    <!-- Ambient grayscale backdrop echoing original CameraHome -->
    <div
      id="life-ambient-bg"
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10 bg-cover bg-center opacity-0 grayscale transition-all duration-700"
      data-initial-cover={initialCover}
      data-initial-cover-avif={initialCoverAvif || undefined}
    />

    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
      <header class="reveal-section flex flex-wrap items-end justify-between gap-6 border-b editorial-hairline pb-8">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#4a4f57]">
            <BiText zh="Life Style · 艺术篇章与生活碎片" en="Life Style · Photo Stories" />
          </p>
          <h1 class="mt-2 text-3xl font-bold tracking-tight text-[#252528] sm:text-4xl">
            Life is full of Art
          </h1>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[#4a4f57] sm:text-base">
            <BiText
              zh="时间流逝得太快，许多事都记不清了。谨以这七个影集与篇章，留住走过的城市、老友、球场与远方。"
              en="Time moves fast. Seven curated chapters preserving friendships, basketball courts, Hangzhou, campus years at AHU, and journeys through London, Japan, and Singapore."
            />
          </p>
        </div>

        <div class="hidden items-center gap-2 md:flex">
          <button
            type="button"
            id="life-prev-btn"
            class="editorial-btn h-10 w-10 p-0"
            aria-label="向左滑动影集"
          >
            ←
          </button>
          <button
            type="button"
            id="life-next-btn"
            class="editorial-btn h-10 w-10 p-0"
            aria-label="向右滑动影集"
          >
            →
          </button>
        </div>
      </header>

      <section
        id="life-album-track"
        class="reveal-section editorial-scroll-hide mt-10 flex cursor-grab snap-x snap-mandatory gap-5 overflow-x-auto pb-4 select-none active:cursor-grabbing"
        aria-label="影集列表"
      >
        {
          albums.map((album, idx) => {
            const coverUrl = withBase(album.data.cover);
            const coverAvifPath = toAvifPath(album.data.cover);
            const coverAvifUrl = coverAvifPath !== album.data.cover ? withBase(coverAvifPath) : '';
            const lqip = albumLqips[idx] || '';
            const preloadThumbs = album.data.items
              .slice(0, 3)
              .map((it) => withBase(getLifeThumbPath(it.image)));
            const preloadThumbsAvif = album.data.items.slice(0, 3).map((it) => {
              const thumb = getLifeThumbPath(it.image);
              return withBase(toAvifPath(thumb));
            });
            return (
              <a
                href={withBase(`/life/${getAlbumSlug(album.id)}/`)}
                data-cover={coverUrl}
                data-cover-avif={coverAvifUrl || undefined}
                data-preload-thumbs={JSON.stringify(preloadThumbs)}
                data-preload-thumbs-avif={JSON.stringify(preloadThumbsAvif)}
                style={lqip ? `background-image: url("${lqip}"); background-size: cover; background-position: center;` : undefined}
                class="life-album-card group relative flex min-h-[430px] w-[82vw] shrink-0 snap-start flex-col justify-between overflow-hidden rounded-2xl border border-[#252528]/20 bg-[#252528] p-6 text-[#f4f6f8] shadow-lg transition-transform duration-300 hover:-translate-y-1 sm:w-[340px] lg:w-[360px]"
              >
                <picture class="absolute inset-0 block h-full w-full">
                  {coverAvifUrl &&
                    (idx < 3 ? (
                      <source type="image/avif" srcset={coverAvifUrl} />
                    ) : (
                      <source type="image/avif" data-srcset={coverAvifUrl} />
                    ))}
                  {idx < 3 ? (
                    <img
                      src={coverUrl}
                      alt={album.data.title}
                      loading="eager"
                      fetchpriority={idx === 0 ? 'high' : 'auto'}
                      decoding="async"
                      draggable="false"
                      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                  ) : (
                    <img
                      data-src={coverUrl}
                      alt={album.data.title}
                      fetchpriority="low"
                      decoding="async"
                      draggable="false"
                      class="h-full w-full object-cover opacity-0 transition-[transform,opacity] duration-700 group-hover:scale-105"
                    />
                  )}
                </picture>
                <div
                  aria-hidden="true"
                  class="absolute inset-0 bg-gradient-to-t from-[#19232c]/90 via-[#19232c]/35 to-[#19232c]/25 transition-opacity duration-300 group-hover:opacity-95"
                />

                <div class="relative z-10 flex items-center justify-between font-mono text-xs">
                  <span class="flex items-center gap-2 tracking-widest">
                    <span>{album.data.number}</span>
                    <span class="inline-block h-[1px] w-7 bg-white/70 transition-all duration-300 group-hover:w-10" />
                  </span>
                  <span class="rounded-full bg-white/15 px-2.5 py-0.5 text-[11px] backdrop-blur-sm">
                    {album.data.items.length} stories
                  </span>
                </div>

                <div class="relative z-10 space-y-2.5">
                  <p class="font-mono text-xs uppercase tracking-wider text-white/75">
                    {album.data.location}
                  </p>
                  <h2 class="text-2xl font-bold leading-tight tracking-tight text-white">
                    {album.data.headline}
                  </h2>
                  <p class="text-xs leading-relaxed text-white/80">
                    <BiText zh={album.data.description} en={album.data.descriptionEn || album.data.description} />
                  </p>
                  <div class="pt-2">
                    <span class="inline-flex items-center gap-2 rounded-full bg-[#27445d] px-3.5 py-1.5 font-mono text-xs text-white transition-colors group-hover:bg-white group-hover:text-[#252528]">
                      <span>Read the Story</span>
                      <span aria-hidden="true">→</span>
                    </span>
                  </div>
                </div>
              </a>
            );
          })
        }
      </section>

      <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between" aria-label="影集进度与快捷切换">
        <div
          id="life-scroll-rail"
          class="group relative flex h-6 flex-1 cursor-pointer items-center"
          role="slider"
          aria-label="横向浏览进度"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          tabindex="0"
        >
          <div class="relative h-[3px] w-full overflow-hidden rounded-full bg-[#252528]/15 transition-all group-hover:h-[5px]">
            <div
              id="life-scroll-thumb"
              class="absolute top-0 bottom-0 left-0 rounded-full bg-[#252528] transition-colors group-hover:bg-[#27445d]"
              style="width: 28%; left: 0%;"
            />
          </div>
        </div>

        <div class="flex items-center justify-between gap-4 sm:justify-end">
          <div class="flex items-center gap-1.5">
            {
              albums.map((album, idx) => (
                <button
                  type="button"
                  data-album-dot={idx}
                  data-album-title={album.data.title}
                  aria-label={`切换到第 ${idx + 1} 个影集 ${album.data.title}`}
                  aria-pressed={idx === 0 ? 'true' : 'false'}
                  class:list={[
                    'h-1.5 cursor-pointer rounded-full transition-all duration-300',
                    idx === 0 ? 'w-6 bg-[#252528]' : 'w-1.5 bg-[#252528]/25 hover:bg-[#252528]/55',
                  ]}
                />
              ))
            }
          </div>
          <span id="life-mobile-counter" class="min-w-[4.2rem] text-right font-mono text-[11px] tracking-wider text-[#4a4f57]">
            01 / {String(albums.length).padStart(2, '0')}
          </span>
        </div>
      </div>
    </div>
  </div>

  <script>
    import '../../scripts/life-index';
  </script>
</EditorialLayout>
