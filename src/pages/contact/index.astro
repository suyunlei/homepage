---
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import { withBase } from '@/lib/paths';
import { encodeEmailForClient, loadSiteAndCvData } from '@/lib/site-data';

const { site } = loadSiteAndCvData();
const emailCodes = site.contact.email ? encodeEmailForClient(site.contact.email) : null;
---

<EditorialLayout
  title={`联系我 · Contact · ${site.owner.nameZh}`}
  description="联系苏云雷（Yunlei Su）：学术交流邮箱、微信二维码、GitHub、微博与个人简介。"
>
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <header class="reveal-section border-b editorial-hairline pb-8">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#4a4f57]">
        Contact · Let us begin our story
      </p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-[#252528] sm:text-4xl">
        联系我 · Get in Touch
      </h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[#4a4f57] sm:text-base">
        可能我们许久未联系了，老朋友；可能我们初次相识，新朋友。无论学术探讨、项目协作还是叙旧问候，都欢迎随时联系。
      </p>
    </header>

    <section class="reveal-section mt-10 grid gap-8 lg:grid-cols-12">
      <!-- Left Column: Author Card + Modernized Accordion -->
      <div class="editorial-card rounded-3xl p-6 sm:p-8 lg:col-span-5">
        <div class="flex flex-col items-center text-center">
          <img
            src={withBase(site.owner.avatar)}
            alt={site.owner.nameZh}
            class="h-24 w-24 rounded-full border-2 border-[#f4f6f8] object-cover shadow-md"
          />
          <h2 class="mt-4 text-xl font-bold text-[#252528]">
            {site.owner.nameZh} · {site.owner.nickname}
          </h2>
          <p class="mt-0.5 font-mono text-xs text-[#4a4f57]">{site.owner.handle}</p>
          <p class="mt-2 text-sm text-[#4a4f57]">{site.contact.bioLine}</p>
        </div>

        <div class="mt-6 divide-y divide-[#252528]/15 border-t border-b editorial-hairline">
          <div>
            <button
              type="button"
              class="flex w-full cursor-pointer items-center justify-between py-3.5 text-left text-sm font-semibold text-[#252528]"
              data-accordion-btn="about"
              aria-expanded="true"
            >
              <span>About · 关于我</span>
              <span class="font-mono text-xs text-[#5d636c]">01</span>
            </button>
            <div class="pb-4 text-sm leading-relaxed text-[#4a4f57]" data-accordion-panel="about">
              <p>
                {site.owner.nameEn}（{site.owner.nameZh}），本科毕业于安徽大学、硕士毕业于新加坡国立大学（NUS），目前于香港科技大学（广州）攻读博士学位；专注 WebGIS、城市数字孪生与人-建筑交互研究，也是球场和美食的忠实爱好者。
              </p>
            </div>
          </div>

          <div>
            <button
              type="button"
              class="flex w-full cursor-pointer items-center justify-between py-3.5 text-left text-sm font-semibold text-[#252528]"
              data-accordion-btn="chat"
              aria-expanded="false"
            >
              <span>Chat Notes · 对话便签</span>
              <span class="font-mono text-xs text-[#5d636c]">02</span>
            </button>
            <div class="hidden space-y-2 pb-4" data-accordion-panel="chat">
              {
                site.contact.chatNotes.map((msg) => (
                  <div
                    class:list={[
                      'flex',
                      msg.side === 'visitor' ? 'justify-end' : 'justify-start',
                    ]}
                  >
                    <span
                      class:list={[
                        'max-w-[85%] rounded-2xl px-3.5 py-2 text-xs leading-relaxed',
                        msg.side === 'visitor'
                          ? 'bg-[#252528]/10 text-[#252528]'
                          : 'bg-[#27445d] text-[#f4f6f8]',
                      ]}
                    >
                      {msg.text}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>

          <div>
            <button
              type="button"
              class="flex w-full cursor-pointer items-center justify-between py-3.5 text-left text-sm font-semibold text-[#252528]"
              data-accordion-btn="thanks"
              aria-expanded="false"
            >
              <span>Thanks · 致谢</span>
              <span class="font-mono text-xs text-[#5d636c]">03</span>
            </button>
            <div class="hidden space-y-2 pb-4 text-sm text-[#4a4f57]" data-accordion-panel="thanks">
              <p class="font-medium text-[#27445d]">{site.owner.nameEn}</p>
              <p class="leading-relaxed">{site.contact.introQuote}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Direct Channels -->
      <div class="space-y-4 lg:col-span-7">
        <!-- Academic Email (Anti-Scrape) -->
        <div class="editorial-card rounded-3xl p-6 sm:p-7">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <p class="font-mono text-xs uppercase tracking-wider text-[#27445d]">
                Academic & Direct Email
              </p>
              <h2 class="mt-1 text-lg font-bold text-[#252528]">电子邮箱</h2>
            </div>
            <span class="rounded-full bg-[#252528]/[0.07] px-2.5 py-1 font-mono text-[11px] text-[#4a4f57]">
              Anti-Scrape Protected
            </span>
          </div>

          {
            emailCodes ? (
              <div class="mt-4 flex flex-wrap items-center gap-3">
                <button
                  type="button"
                  id="contact-email-reveal"
                  class="editorial-btn editorial-btn--primary"
                  data-email-codes={JSON.stringify(emailCodes)}
                >
                  点击显示邮箱地址
                </button>
                <span
                  id="contact-email-output"
                  class="hidden rounded-xl bg-white/65 px-3.5 py-2 font-mono text-sm text-[#252528]"
                />
                <button
                  type="button"
                  id="contact-email-copy"
                  class="editorial-pill hidden cursor-pointer hover:border-[#252528]"
                >
                  Copy
                </button>
              </div>
            ) : (
              <p class="mt-3 text-sm leading-relaxed text-[#4a4f57]">
                当前公开仓库未明文托管私人邮箱地址。可通过右侧/下方微信二维码或 GitHub 联系，站长亦可在本地构建配置 <code class="font-mono text-xs">content/private.local.json</code> 中注入邮箱后自动开启一键解码复制。
              </p>
            )
          }
        </div>

        <!-- Social & Academic Links Grid -->
        <div class="grid gap-4 sm:grid-cols-2">
          {
            site.contact.wechatQr && (
              <div class="editorial-card flex flex-col justify-between rounded-2xl p-5">
                <div>
                  <p class="font-mono text-xs uppercase tracking-wider text-[#27445d]">WeChat</p>
                  <h3 class="mt-1 text-base font-semibold text-[#252528]">微信联系</h3>
                  <p class="mt-1.5 text-xs leading-relaxed text-[#4a4f57]">
                    {site.contact.wechatHint}
                  </p>
                  {site.contact.wechatId && (
                    <p class="mt-2 font-mono text-xs text-[#252528]">
                      ID: {site.contact.wechatId}
                    </p>
                  )}
                </div>
                <div class="mt-4">
                  <button
                    type="button"
                    id="wechat-qr-open"
                    class="editorial-btn w-full"
                  >
                    查看微信二维码
                  </button>
                </div>
              </div>
            )
          }

          {
            site.contact.githubUrl && (
              <a
                href={site.contact.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="editorial-card group flex flex-col justify-between rounded-2xl p-5 transition-colors hover:border-[#252528]/40"
              >
                <div>
                  <p class="font-mono text-xs uppercase tracking-wider text-[#27445d]">GitHub</p>
                  <h3 class="mt-1 text-base font-semibold text-[#252528]">开源代码与仓库</h3>
                  <p class="mt-1.5 font-mono text-xs text-[#4a4f57]">
                    {site.contact.githubUrl.replace(/^https?:\/\//, '')}
                  </p>
                </div>
                <span class="mt-4 font-mono text-xs text-[#252528] group-hover:underline">
                  Visit Profile ↗
                </span>
              </a>
            )
          }

          {
            site.contact.weiboUrl && (
              <a
                href={site.contact.weiboUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="editorial-card group flex flex-col justify-between rounded-2xl p-5 transition-colors hover:border-[#252528]/40"
              >
                <div>
                  <p class="font-mono text-xs uppercase tracking-wider text-[#27445d]">Weibo</p>
                  <h3 class="mt-1 text-base font-semibold text-[#252528]">微博动态</h3>
                  <p class="mt-1.5 text-xs text-[#4a4f57]">日常碎片与随手记录</p>
                </div>
                <span class="mt-4 font-mono text-xs text-[#252528] group-hover:underline">
                  Open Weibo ↗
                </span>
              </a>
            )
          }

          <div class="editorial-card flex flex-col justify-between rounded-2xl p-5">
            <div>
              <p class="font-mono text-xs uppercase tracking-wider text-[#27445d]">
                Mini Program / Links
              </p>
              <h3 class="mt-1 text-base font-semibold text-[#252528]">其他渠道</h3>
              <p class="mt-1.5 text-xs leading-relaxed text-[#4a4f57]">
                {site.contact.miniProgramNote}
              </p>
              {site.contact.office && (
                <p class="mt-1 font-mono text-xs text-[#5d636c]">{site.contact.office}</p>
              )}
            </div>
            <div class="mt-4 flex flex-wrap gap-2">
              {
                site.contact.scholarUrl && (
                  <a
                    href={site.contact.scholarUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="editorial-pill hover:border-[#252528]"
                  >
                    Scholar ↗
                  </a>
                )
              }
              {
                site.contact.orcidUrl && (
                  <a
                    href={site.contact.orcidUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="editorial-pill hover:border-[#252528]"
                  >
                    ORCID ↗
                  </a>
                )
              }
              <a href={withBase('/academic/')} class="editorial-pill hover:border-[#252528]">
                Academic Page →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  {
    site.contact.wechatQr && (
      <div
        id="wechat-qr-modal"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-[#18191c]/80 p-4 backdrop-blur-sm"
        role="dialog"
        aria-modal="true"
        aria-label="微信二维码"
      >
        <div class="editorial-card-solid relative max-w-xs rounded-3xl p-6 text-center shadow-2xl">
          <button
            type="button"
            id="wechat-qr-close"
            class="absolute top-3 right-3 rounded-full border border-[#252528]/20 px-2.5 py-1 font-mono text-xs text-[#252528] hover:bg-[#252528] hover:text-white"
            aria-label="关闭二维码弹窗"
          >
            ✕
          </button>
          <p class="font-mono text-xs uppercase tracking-widest text-[#27445d]">WeChat QR</p>
          <h3 class="mt-1 text-base font-bold text-[#252528]">添加微信好友</h3>
          <img
            src={withBase(site.contact.wechatQr)}
            alt="微信二维码"
            class="mt-4 w-full rounded-2xl border editorial-hairline object-contain"
          />
          <p class="mt-3 text-xs text-[#4a4f57]">{site.contact.wechatHint}</p>
        </div>
      </div>
    )
  }

  <script>
    import '../../scripts/contact';
  </script>
</EditorialLayout>
