---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LangToggle from '@/components/LangToggle.astro';
import BiText from '@/components/BiText.astro';
import { withBase } from '@/lib/paths';
import { loadSiteAndCvData } from '@/lib/site-data';

const { site } = loadSiteAndCvData();

const quickLinks = [
  { label: 'Academic', href: '/academic/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Life Style', href: '/life/' },
  { label: 'Contact', href: '/contact/' },
];
---

<BaseLayout
  title={site.siteTitle}
  titleEn={site.siteTitleEn || site.siteTitle}
  description={site.siteDescription}
  bodyClass="stage-body"
>
  <main class="stage-main">
    <!-- Fixed Editorial Frame -->
    <header class="stage-frame">
      <div class="stage-frame__top">
        <div class="space-y-1">
          <h1 class="text-sm font-medium tracking-tight text-[#252528] sm:text-base">
            {site.heroFrameTitle}
          </h1>
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-[#4a4f57]">
            <span data-i18n="zh">{site.owner.nameZh} · {site.heroFrameSubtitle}</span>
            <span data-i18n="en">{site.owner.nameEn} · {site.heroFrameSubtitleEn || site.heroFrameSubtitle}</span>
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-4 sm:gap-6">
          <nav
            class="stage-frame__links pointer-events-auto flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-medium tracking-wide text-[#252528]"
            aria-label="快速入口"
          >
            {
              quickLinks.map((link) => (
                <a
                  href={withBase(link.href)}
                  class="border-b border-transparent pb-0.5 transition-colors hover:border-[#252528]"
                >
                  {link.label}
                </a>
              ))
            }
          </nav>

          <LangToggle />
        </div>
      </div>
    </header>

    <!-- Second Layer: Split-Screen Editorial Previews -->
    <section class="content--second" aria-label="板块预览详情">
      {
        site.homePanels.map((panel, index) => (
          <article class="stage-item" data-panel-index={index}>
            <div
              class="stage-item__img"
              data-bg={withBase(panel.image)}
              aria-hidden="true"
            />
            <div class="stage-item__content">
              <button type="button" class="stage-back">
                <BiText zh="← 返回" en="← back" />
              </button>
              <p class="mt-5 font-mono text-xs uppercase tracking-[0.2em] text-[#4a4f57]">
                0{index + 1} / {panel.menuLabel}
              </p>
              <h2 class="stage-title">
                <span class="stage-title__zh" data-i18n="zh">{panel.title}</span>
                <span class="stage-title__en" data-i18n="en">{panel.titleEn || panel.title}</span>
              </h2>
              <h3 class="stage-subtitle">
                <BiText zh={panel.subtitle} en={panel.subtitleEn || panel.subtitle} />
              </h3>
              <div class="stage-text" data-i18n="zh">
                {panel.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
              <div class="stage-text" data-i18n="en">
                {(panel.paragraphsEn && panel.paragraphsEn.length > 0 ? panel.paragraphsEn : panel.paragraphs).map((p) => (
                  <p>{p}</p>
                ))}
              </div>
              <div class="mt-8">
                <a href={withBase(panel.ctaHref)} class="editorial-btn editorial-btn--primary">
                  <BiText zh={panel.ctaLabel} en={panel.ctaLabelEn || panel.ctaLabel} />
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </section>

    <!-- First Layer: 4-Column Parallax Photo Grid + Kinetic Outlined Menu -->
    <section class="content--first" aria-label="主视觉导航幕布">
      <div class="content__move">
        <div class="columns" aria-hidden="true">
          {
            site.homeColumns.map((col) => (
              <div class:list={['column', col.bottom && 'column--bottom']}>
                {col.images.map((imgPath, imgIdx) => {
                  const isAboveFold = col.bottom
                    ? imgIdx >= col.images.length - 2
                    : imgIdx < 2;
                  return (
                    <div class="column__img">
                      <img
                        src={withBase(imgPath)}
                        alt=""
                        loading={isAboveFold ? 'eager' : 'lazy'}
                        decoding="async"
                        fetchpriority={isAboveFold ? 'high' : 'auto'}
                        class="column__photo"
                      />
                    </div>
                  );
                })}
              </div>
            ))
          }
        </div>

        <script is:inline>
          (function () {
            var imgs = document.querySelectorAll('.column__photo');
            for (var i = 0; i < imgs.length; i++) {
              var img = imgs[i];
              if (!img.complete) {
                img.setAttribute('data-pending', '');
                var clear = (function (el) {
                  return function () {
                    el.removeAttribute('data-pending');
                  };
                })(img);
                img.addEventListener('load', clear, { once: true });
                img.addEventListener('error', clear, { once: true });
                if (img.complete) img.removeAttribute('data-pending');
              }
            }
          })();
        </script>

        <nav class="menu" aria-label="主页交互式导航">
          {
            site.homePanels.map((panel, index) => (
              <button
                type="button"
                class="menu__item menu-stroke-text"
                data-menu-index={index}
              >
                {panel.menuLabel}
              </button>
            ))
          }
        </nav>
      </div>
    </section>
  </main>

  <script>
    import '../scripts/home-stage';
  </script>
</BaseLayout>

<style>
  :global(body.stage-body) {
    height: 100vh;
    overflow: hidden;
  }

  .stage-main {
    position: relative;
    width: 100%;
    height: 100vh;
    display: grid;
    grid-template-columns: 100%;
    grid-template-rows: 100%;
    overflow: hidden;
  }

  .stage-frame {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
    padding: 1.5rem 1.5rem;
    pointer-events: none;
  }

  @media (min-width: 53em) {
    .stage-frame {
      padding: 2.25rem 3.5rem;
    }
  }

  .stage-frame__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  :global(body.stage-panel-open) .stage-frame__links {
    opacity: 0;
    pointer-events: none;
  }

  .stage-frame__links {
    transition: opacity 0.25s ease;
  }

  .content--first,
  .content__move {
    width: 100%;
    height: 100vh;
    display: grid;
    grid-template-columns: 100%;
    grid-template-rows: 100%;
    align-items: center;
    justify-items: center;
    grid-area: 1 / 1 / 2 / 2;
    position: relative;
  }

  .content--first {
    position: fixed;
    inset: 0;
    z-index: 20;
    overflow: hidden;
  }

  .content__move {
    background: var(--bg-slate);
  }

  .columns {
    grid-area: 1 / 1 / 2 / 2;
    width: 100%;
    height: 100vh;
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: 100%;
    gap: 1.25rem;
    padding: 0 6vw;
  }

  .column {
    position: relative;
    align-self: start;
    will-change: transform;
  }

  .column--bottom {
    align-self: end;
  }

  .column__img {
    width: 100%;
    display: block;
    opacity: 0.42;
    background: rgba(37, 37, 40, 0.08);
    height: clamp(140px, 24vw, 380px);
    border-radius: 2px;
    overflow: hidden;
  }

  .column__img:nth-child(odd) {
    height: clamp(170px, 29vw, 460px);
  }

  .column__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.4s ease-out;
  }

  .column__photo[data-pending] {
    opacity: 0;
  }

  .column__img:not(:last-child) {
    margin-bottom: 1.25rem;
  }

  @media (max-width: 52.99em) {
    .columns {
      padding: 0 2.5vw;
      gap: 0.625rem;
    }

    .column__img {
      height: clamp(165px, 24vw, 380px);
    }

    .column__img:nth-child(odd) {
      height: clamp(195px, 29vw, 460px);
    }

    .column__img:not(:last-child) {
      margin-bottom: 0.625rem;
    }
  }

  .menu {
    grid-area: 1 / 1 / 2 / 2;
    width: 100%;
    height: 100vh;
    padding: 6rem 1.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .menu__item {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    padding: 0.15rem 0.5rem 0.4rem;
    font-weight: 800;
    font-size: clamp(2.25rem, 11vw, 3.8rem);
    line-height: 1.06;
    cursor: pointer;
    letter-spacing: -0.02em;
  }

  @media (min-width: 53em) {
    .menu__item {
      font-size: clamp(2.8rem, 10vh, 6.8rem);
    }
  }

  .content--second {
    grid-area: 1 / 1 / 2 / 2;
    position: relative;
    width: 100%;
    height: 100vh;
    z-index: 10;
  }

  .stage-item {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    background: var(--bg-slate);
  }

  .stage-item.is-current {
    opacity: 1;
    pointer-events: auto;
    z-index: 5;
  }

  .stage-item__img {
    height: 34vh;
    min-height: 210px;
    width: 100%;
    flex: none;
    background-color: rgba(37, 37, 40, 0.08);
    background-size: cover;
    background-position: 50% 35%;
    opacity: 0.48;
  }

  .stage-item__content {
    flex: 1;
    overflow-y: auto;
    padding: 1.75rem 1.5rem 3rem;
  }

  .stage-back {
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink-primary);
    letter-spacing: 0.04em;
    transition: opacity 0.2s ease;
  }

  .stage-back:hover {
    opacity: 0.65;
  }

  .stage-title {
    margin: 0.5rem 0 0;
    font-size: clamp(2.1rem, 5vw, 4.4rem);
    font-weight: 700;
    line-height: 1.12;
    color: var(--ink-primary);
  }

  .stage-subtitle {
    margin: 0.5rem 0 0;
    font-size: clamp(1.05rem, 1.8vw, 1.5rem);
    font-weight: 400;
    color: var(--ink-secondary);
  }

  .stage-text {
    margin-top: 2rem;
    max-width: 36rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--ink-primary);
  }

  @media (min-width: 53em) {
    .stage-item {
      flex-direction: row;
    }

    .stage-item__img {
      height: 100%;
      width: 44%;
      background-position: 50% 50%;
    }

    .stage-item__content {
      padding: 7.5rem 7vw 3rem 6vw;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
    }
  }
</style>
