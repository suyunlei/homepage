---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LangToggle from '@/components/LangToggle.astro';
import BiText from '@/components/BiText.astro';
import { toAvifPath, withBase } from '@/lib/paths';
import { getLqipDataUri } from '@/lib/lqip';
import { loadSiteAndCvData } from '@/lib/site-data';

const { site } = loadSiteAndCvData();

const uniqueHomeImgs = Array.from(new Set(site.homeColumns.flatMap((col) => col.images)));
const homeLqipEntries = await Promise.all(
  uniqueHomeImgs.map(async (imgPath) => [imgPath, await getLqipDataUri(imgPath)] as const),
);
const homeLqipIndex = new Map<string, number>();
const lqipVars: string[] = [];
homeLqipEntries.forEach(([imgPath, uri], idx) => {
  if (uri) {
    homeLqipIndex.set(imgPath, idx);
    lqipVars.push(`--lqip-${idx}:url("${uri}")`);
  }
});
const homeLqipCss = lqipVars.length > 0 ? `:root{${lqipVars.join(';')}}` : '';

const panelAssets = site.homePanels.map((panel) => {
  const avifPath = toAvifPath(panel.image);
  return {
    avifUrl: avifPath !== panel.image ? withBase(avifPath) : '',
    webpUrl: withBase(panel.image),
  };
});

const quickLinks = [
  { label: 'Academic', href: '/academic/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Life Style', href: '/life/' },
  { label: 'Contact', href: '/contact/' },
];
---

<BaseLayout
  title={site.siteTitle}
  titleEn={site.siteTitleEn || site.siteTitle}
  description={site.siteDescription}
  bodyClass="stage-body"
>
  <script is:inline slot="head">
    (function () {
      try {
        var root = document.documentElement;
        var reduce =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var navEntries =
          window.performance && performance.getEntriesByType
            ? performance.getEntriesByType('navigation')
            : null;
        var navType = navEntries && navEntries[0] ? navEntries[0].type : '';
        var seen = false;
        try {
          seen = sessionStorage.getItem('home-preloaded') === '1';
        } catch (e) {}
        var sameOrigin = false;
        if (document.referrer) {
          try {
            sameOrigin = new URL(document.referrer).origin === window.location.origin;
          } catch (e) {}
        }
        if (reduce || (seen && navType !== 'reload' && sameOrigin)) {
          root.classList.add('preloader-skip', 'stage-revealed');
        } else {
          root.classList.add('preloader-active');
        }
      } catch (e) {
        document.documentElement.classList.add('preloader-skip', 'stage-revealed');
      }
    })();
  </script>
  {homeLqipCss && <style slot="head" is:inline set:html={homeLqipCss} />}
  <main class="stage-main">
    <!-- Playful Editorial Preloader Curtain (first load / reload only) -->
    <div
      id="stage-preloader"
      class="preloader"
      role="status"
      aria-live="polite"
      aria-label="正在加载首页内容"
    >
      <div class="preloader__grid" aria-hidden="true"></div>
      <div id="preloader-ripples" class="preloader__ripples" aria-hidden="true"></div>

      <div
        class="preloader__corners font-mono text-[10px] tracking-[0.18em] uppercase text-[#252528]/70"
        aria-hidden="true"
      >
        <span id="preloader-coord" class="preloader__corner preloader__corner--tr">
          22.89°N · 113.48°E · HKUST(GZ)
        </span>
        <span class="preloader__corner preloader__corner--bl flex items-center gap-2">
          <span class="preloader__dot"></span>
          <span>LOADING ARCHIVE</span>
        </span>
      </div>

      <div id="preloader-core" class="preloader__core">
        <div class="preloader__compass">
          <svg
            class="preloader__svg"
            viewBox="0 0 120 120"
            width="116"
            height="116"
            aria-hidden="true"
          >
            <g class="preloader__ring-outer">
              <circle
                cx="60"
                cy="60"
                r="54"
                fill="none"
                stroke="rgba(37,37,40,0.22)"
                stroke-width="1"
                stroke-dasharray="3 4"
              />
              <line x1="60" y1="2" x2="60" y2="9" stroke="#252528" stroke-width="1.2" />
              <line x1="60" y1="111" x2="60" y2="118" stroke="rgba(37,37,40,0.45)" stroke-width="1" />
              <line x1="2" y1="60" x2="9" y2="60" stroke="rgba(37,37,40,0.45)" stroke-width="1" />
              <line x1="111" y1="60" x2="118" y2="60" stroke="rgba(37,37,40,0.45)" stroke-width="1" />
            </g>
            <g class="preloader__ring-inner">
              <circle
                cx="60"
                cy="60"
                r="44"
                fill="none"
                stroke="rgba(37,37,40,0.12)"
                stroke-width="1.75"
              />
              <circle
                id="preloader-arc"
                cx="60"
                cy="60"
                r="44"
                fill="none"
                stroke="#27445d"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-dasharray="276.46"
                stroke-dashoffset="276.46"
                transform="rotate(-90 60 60)"
              />
            </g>
          </svg>
          <img
            src={withBase('/favicon.svg?v=su')}
            alt="苏"
            width="44"
            height="44"
            class="preloader__seal"
            decoding="async"
          />
        </div>

        <div class="preloader__pct font-mono" id="preloader-pct">00%</div>

        <div class="preloader__track" aria-hidden="true">
          <div id="preloader-bar" class="preloader__bar"></div>
        </div>

        <p class="preloader__status">
          <span id="preloader-status-zh" data-i18n="zh">正在唤醒 36 帧生活切片...</span>
          <span id="preloader-status-en" data-i18n="en">Waking up 36 visual slices...</span>
        </p>
      </div>
    </div>
    <!-- Fixed Editorial Frame -->
    <header class="stage-frame">
      <div class="stage-frame__top">
        <div class="stage-frame__intro min-w-0 flex-1 space-y-1">
          <h1 class="stage-frame__title text-sm font-medium tracking-tight text-[#252528] sm:text-base">
            {site.heroFrameTitle}
          </h1>
          <p class="stage-frame__subtitle font-mono text-[10px] leading-relaxed uppercase tracking-[0.12em] text-[#4a4f57] sm:text-[11px] sm:tracking-[0.14em]">
            <span data-i18n="zh">{site.owner.nameZh} · {site.heroFrameSubtitle}</span>
            <span data-i18n="en">{site.owner.nameEn} · {site.heroFrameSubtitleEn || site.heroFrameSubtitle}</span>
          </p>
        </div>

        <div class="stage-frame__actions ml-auto flex shrink-0 items-center gap-4 sm:gap-6">
          <nav
            class="stage-frame__links pointer-events-auto flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-medium tracking-wide text-[#252528]"
            aria-label="快速入口"
          >
            {
              quickLinks.map((link) => (
                <a
                  href={withBase(link.href)}
                  class="border-b border-transparent pb-0.5 transition-colors hover:border-[#252528]"
                >
                  {link.label}
                </a>
              ))
            }
          </nav>

          <LangToggle />
        </div>
      </div>
    </header>

    <!-- Second Layer: Split-Screen Editorial Previews -->
    <section class="content--second" aria-label="板块预览详情">
      {
        site.homePanels.map((panel, index) => {
          const media = panelAssets[index];
          return (
            <article class="stage-item" data-panel-index={index}>
              <div
                class:list={[
                  'stage-item__img',
                  panel.imageFit === 'contain' && 'stage-item__img--contain',
                ]}
                style={panel.imageBg ? `background-color: ${panel.imageBg};` : 'background-color: #252528;'}
                aria-hidden="true"
              >
                <picture class="stage-item__picture">
                  {media.avifUrl && <source type="image/avif" data-srcset={media.avifUrl} />}
                  <img
                    data-src={media.webpUrl}
                    alt=""
                    decoding="async"
                    class:list={[
                      'stage-item__photo',
                      panel.imageFit === 'contain' && 'stage-item__photo--contain',
                    ]}
                    data-pending=""
                  />
                </picture>
              </div>
            <div class="stage-item__content">
              <button type="button" class="stage-back">
                <BiText zh="← 返回" en="← back" />
              </button>
              <p class="mt-5 font-mono text-xs uppercase tracking-[0.2em] text-[#4a4f57]">
                0{index + 1} / {panel.menuLabel}
              </p>
              <h2 class="stage-title">
                <span class="stage-title__zh" data-i18n="zh">{panel.title}</span>
                <span class="stage-title__en" data-i18n="en">{panel.titleEn || panel.title}</span>
              </h2>
              <h3 class="stage-subtitle">
                <BiText zh={panel.subtitle} en={panel.subtitleEn || panel.subtitle} />
              </h3>
              <div class="stage-text" data-i18n="zh">
                {panel.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
              <div class="stage-text" data-i18n="en">
                {(panel.paragraphsEn && panel.paragraphsEn.length > 0 ? panel.paragraphsEn : panel.paragraphs).map((p) => (
                  <p>{p}</p>
                ))}
              </div>
              <div class="mt-8">
                <a href={withBase(panel.ctaHref)} class="editorial-btn editorial-btn--primary">
                  <BiText zh={panel.ctaLabel} en={panel.ctaLabelEn || panel.ctaLabel} />
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </article>
          );
        })
      }
    </section>

    <!-- First Layer: Parallax Photo Mosaic + Kinetic Outlined Menu -->
    <section class="content--first" aria-label="主视觉导航幕布">
      <div class="content__move">
        <div class="columns" aria-hidden="true">
          {
            site.homeColumns.map((col, colIdx) => {
              const isDesktopOnlyCol = colIdx >= 4;
              return (
                <div
                  class:list={['column', col.bottom && 'column--bottom']}
                  data-desktop-only={isDesktopOnlyCol ? '1' : undefined}
                >
                  {col.images.map((imgPath, imgIdx) => {
                    const len = col.images.length;
                    const isTier1 = !isDesktopOnlyCol && (col.bottom ? imgIdx >= len - 2 : imgIdx < 2);
                    const isWave1 = isDesktopOnlyCol
                      ? col.bottom
                        ? imgIdx >= len - 4
                        : imgIdx < 4
                      : col.bottom
                        ? imgIdx >= len - 4 && imgIdx < len - 2
                        : imgIdx >= 2 && imgIdx < 4;
                    const lqipIdx = homeLqipIndex.get(imgPath);
                    const avifPath = toAvifPath(imgPath);
                    return (
                      <div
                        class="column__img"
                        style={lqipIdx !== undefined ? `background-image: var(--lqip-${lqipIdx});` : undefined}
                      >
                        <picture class="column__picture">
                          {avifPath !== imgPath &&
                            (isTier1 ? (
                              <source type="image/avif" srcset={withBase(avifPath)} />
                            ) : (
                              <source type="image/avif" data-srcset={withBase(avifPath)} />
                            ))}
                          {isTier1 ? (
                            <img
                              src={withBase(imgPath)}
                              alt=""
                              loading="eager"
                              decoding="async"
                              fetchpriority="high"
                              class="column__photo"
                            />
                          ) : (
                            <img
                              data-src={withBase(imgPath)}
                              data-wave={isWave1 ? '1' : '2'}
                              alt=""
                              decoding="async"
                              fetchpriority="low"
                              class="column__photo"
                              data-pending=""
                            />
                          )}
                        </picture>
                      </div>
                    );
                  })}
                </div>
              );
            })
          }
        </div>

        <script is:inline>
          (function () {
            var rootEl = document.documentElement;
            var isPreloader = rootEl.classList.contains('preloader-active');
            var doneWaves = { '1': false, '2': false };
            var doneDesktopWaves = { '1': false, '2': false };
            var waveTimer1 = 0;
            var tier1ReadyDispatched = false;
            var panelsHydrated = false;

            function markLoaded(el) {
              el.removeAttribute('data-pending');
            }

            function isReallyLoaded(img) {
              return Boolean(img.complete && img.naturalWidth > 0);
            }

            function bindClear(el, onSettle) {
              var settled = false;
              var finish = function () {
                if (settled) return;
                settled = true;
                markLoaded(el);
                if (onSettle) onSettle();
              };
              el.addEventListener('load', finish, { once: true });
              el.addEventListener('error', finish, { once: true });
              if (isReallyLoaded(el)) finish();
            }

            function waitDecode(img) {
              return new Promise(function (resolve) {
                var done = false;
                var finish = function () {
                  if (done) return;
                  done = true;
                  markLoaded(img);
                  if (img.naturalWidth > 0 && typeof img.decode === 'function') {
                    img.decode().catch(function () {}).finally(resolve);
                  } else {
                    resolve();
                  }
                };
                img.addEventListener('load', finish, { once: true });
                img.addEventListener('error', finish, { once: true });
                Promise.resolve().then(function () {
                  if (!done && isReallyLoaded(img)) {
                    finish();
                  }
                });
              });
            }

            function activatePicture(img, priority) {
              var url = img.getAttribute('data-src');
              if (!url) return false;
              if (priority) {
                img.setAttribute('fetchpriority', priority);
              }
              bindClear(img, null);
              var pic = img.parentElement;
              if (pic && pic.tagName === 'PICTURE') {
                var sources = pic.querySelectorAll('source[data-srcset]');
                for (var j = 0; j < sources.length; j++) {
                  var sUrl = sources[j].getAttribute('data-srcset');
                  if (sUrl) {
                    sources[j].setAttribute('srcset', sUrl);
                    sources[j].removeAttribute('data-srcset');
                  }
                }
              }
              img.removeAttribute('data-src');
              img.setAttribute('src', url);
              if (isReallyLoaded(img)) markLoaded(img);
              return true;
            }

            function emitTier1Ready() {
              if (tier1ReadyDispatched) return;
              tier1ReadyDispatched = true;
              window.dispatchEvent(new Event('home-tier1-ready'));
            }

            function hydrateWave(wave, forceDesktop, priority) {
              var desktopNow = Boolean(forceDesktop) || window.innerWidth >= 848;
              if (doneWaves[wave] && (!desktopNow || doneDesktopWaves[wave])) return [];
              doneWaves[wave] = true;
              if (desktopNow) doneDesktopWaves[wave] = true;

              if (wave === '1') {
                if (waveTimer1) {
                  clearTimeout(waveTimer1);
                  waveTimer1 = 0;
                }
                emitTier1Ready();
              }

              var hydrated = [];
              var targets = document.querySelectorAll('.column__photo[data-wave="' + wave + '"][data-src]');
              for (var i = 0; i < targets.length; i++) {
                var img = targets[i];
                var colEl = img.closest('.column');
                if (!desktopNow && colEl && colEl.getAttribute('data-desktop-only') === '1') {
                  continue;
                }
                if (activatePicture(img, priority)) {
                  hydrated.push(img);
                }
              }
              return hydrated;
            }

            window.__hydrateHomeWall = function () {
              hydrateWave('1');
              hydrateWave('2');
            };

            window.__hydrateAllPanels = function (priority) {
              if (panelsHydrated) return [];
              panelsHydrated = true;
              var imgs = document.querySelectorAll('.stage-item__photo[data-src]');
              var list = [];
              for (var i = 0; i < imgs.length; i++) {
                activatePicture(imgs[i], priority);
                list.push(imgs[i]);
              }
              return list;
            };

            function onResizeWide() {
              if (window.innerWidth >= 848) {
                hydrateWave('1', true);
                hydrateWave('2', true);
                window.removeEventListener('resize', onResizeWide);
              }
            }
            if (window.innerWidth < 848) {
              window.addEventListener('resize', onResizeWide, { passive: true });
            }

            if (isPreloader) {
              var preloaderEl = document.getElementById('stage-preloader');
              var coreEl = document.getElementById('preloader-core');
              var sealEl = preloaderEl ? preloaderEl.querySelector('.preloader__seal') : null;
              var ripplesEl = document.getElementById('preloader-ripples');
              var coordEl = document.getElementById('preloader-coord');
              var arcEl = document.getElementById('preloader-arc');
              var pctEl = document.getElementById('preloader-pct');
              var barEl = document.getElementById('preloader-bar');
              var statusZhEl = document.getElementById('preloader-status-zh');
              var statusEnEl = document.getElementById('preloader-status-en');

              var coords = [
                '31.77°N · 117.18°E · AHU',
                '1.30°N · 103.78°E · NUS',
                '22.89°N · 113.48°E · HKUST(GZ)',
              ];
              var coordIdx = 0;
              var stagesZh = [
                '正在唤醒 36 帧生活切片...',
                '正在校准城市数字孪生坐标...',
                '正在给猫猫顺毛 & 铺好高清展板...',
                '欢迎来到苏云雷的世界 ✦',
              ];
              var stagesEn = [
                'Waking up 36 visual slices...',
                'Calibrating urban digital twin coords...',
                'Petting the cats & unrolling HD panels...',
                "Welcome to Yunlei Su's World ✦",
              ];
              var lastStageIdx = 0;

              var wallImgs = Array.prototype.slice.call(
                document.querySelectorAll('.column__photo[src]'),
              );
              var wave1Imgs = hydrateWave('1', false, 'high');
              var wave2Imgs = hydrateWave('2', false, 'high');
              for (var k1 = 0; k1 < wave1Imgs.length; k1++) {
                wallImgs.push(wave1Imgs[k1]);
              }
              for (var k2 = 0; k2 < wave2Imgs.length; k2++) {
                wallImgs.push(wave2Imgs[k2]);
              }

              var panelImgs = window.__hydrateAllPanels('auto');
              if (panelImgs.length === 0) {
                panelImgs = Array.prototype.slice.call(
                  document.querySelectorAll('.stage-item__photo'),
                );
              }

              var wallDone = 0;
              var wallTotal = Math.max(1, wallImgs.length);
              wallImgs.forEach(function (img) {
                if (!isReallyLoaded(img)) {
                  img.setAttribute('data-pending', '');
                }
                waitDecode(img).then(function () {
                  wallDone += 1;
                });
              });

              var panelDone = 0;
              var panelTotal = Math.max(1, panelImgs.length);
              panelImgs.forEach(function (img) {
                waitDecode(img).then(function () {
                  panelDone += 1;
                });
              });

              var extrasDone = 0;
              var extrasTotal = 2;
              if (document.fonts && document.fonts.ready) {
                document.fonts.ready.then(function () {
                  extrasDone += 1;
                });
              } else {
                extrasDone += 1;
              }

              var gsapStarted = false;
              var triggerGsapLoad = function () {
                if (gsapStarted) return;
                if (typeof window.__loadHomeGsap === 'function') {
                  gsapStarted = true;
                  Promise.resolve(window.__loadHomeGsap())
                    .catch(function () {})
                    .finally(function () {
                      extrasDone += 1;
                    });
                }
              };
              triggerGsapLoad();
              window.addEventListener('DOMContentLoaded', triggerGsapLoad, { once: true });
              var gsapFallback = window.setTimeout(function () {
                if (!gsapStarted) {
                  gsapStarted = true;
                  if (typeof window.__loadHomeGsap === 'function') {
                    Promise.resolve(window.__loadHomeGsap())
                      .catch(function () {})
                      .finally(function () {
                        extrasDone += 1;
                      });
                  } else {
                    extrasDone += 1;
                  }
                }
              }, 350);

              var coordTimer = window.setInterval(function () {
                coordIdx = (coordIdx + 1) % coords.length;
                if (coordEl) coordEl.textContent = coords[coordIdx];
              }, 560);

              var onPreloaderMove = function (ev) {
                if (!coreEl || (preloaderEl && preloaderEl.classList.contains('is-leaving'))) return;
                var nx = (ev.clientX / Math.max(1, window.innerWidth) - 0.5) * 2;
                var ny = (ev.clientY / Math.max(1, window.innerHeight) - 0.5) * 2;
                coreEl.style.transform =
                  'perspective(720px) rotateX(' +
                  (-ny * 7).toFixed(2) +
                  'deg) rotateY(' +
                  (nx * 7).toFixed(2) +
                  'deg)';
              };

              var onPreloaderTap = function (ev) {
                if (ripplesEl) {
                  var cx = ev.clientX || window.innerWidth / 2;
                  var cy = ev.clientY || window.innerHeight / 2;
                  var ring = document.createElement('span');
                  ring.className = 'preloader__ripple';
                  ring.style.left = cx + 'px';
                  ring.style.top = cy + 'px';
                  ripplesEl.appendChild(ring);
                  window.setTimeout(function () {
                    if (ring.parentNode) ring.parentNode.removeChild(ring);
                  }, 720);
                }
                if (sealEl) {
                  sealEl.classList.remove('is-pop');
                  void sealEl.offsetWidth;
                  sealEl.classList.add('is-pop');
                }
              };

              if (preloaderEl) {
                preloaderEl.addEventListener('pointermove', onPreloaderMove, { passive: true });
                preloaderEl.addEventListener('pointerdown', onPreloaderTap, { passive: true });
              }

              var t0 = performance.now();
              var minDuration = 1050;
              var maxWait = 7000;
              var displayPct = 0;
              var finished = false;

              var finishReveal = function () {
                if (finished) return;
                finished = true;
                clearInterval(coordTimer);
                clearTimeout(gsapFallback);
                try {
                  sessionStorage.setItem('home-preloaded', '1');
                } catch (e) {}

                if (pctEl) pctEl.textContent = '100%';
                if (barEl) barEl.style.transform = 'scaleX(1)';
                if (arcEl) arcEl.style.strokeDashoffset = '0';
                if (statusZhEl) statusZhEl.textContent = stagesZh[3];
                if (statusEnEl) statusEnEl.textContent = stagesEn[3];

                window.setTimeout(function () {
                  rootEl.classList.add('stage-revealed');
                  rootEl.classList.remove('preloader-active');
                  window.dispatchEvent(new Event('home-stage-revealed'));
                  if (preloaderEl) {
                    preloaderEl.classList.add('is-leaving');
                    preloaderEl.removeEventListener('pointermove', onPreloaderMove);
                    preloaderEl.removeEventListener('pointerdown', onPreloaderTap);
                    window.setTimeout(function () {
                      preloaderEl.style.display = 'none';
                    }, 740);
                  }
                }, 220);
              };

              var tickPreloader = function (now) {
                if (finished) return;
                var elapsed = now - t0;
                var allLoaded =
                  wallDone >= wallTotal && panelDone >= panelTotal && extrasDone >= extrasTotal;
                var realPct =
                  55 * (wallDone / wallTotal) +
                  30 * (panelDone / panelTotal) +
                  15 * (extrasDone / extrasTotal);

                var minRatio = Math.min(1, elapsed / minDuration);
                var cappedTarget;
                if (elapsed >= maxWait || (allLoaded && elapsed >= minDuration)) {
                  cappedTarget = 100;
                } else {
                  cappedTarget = Math.min(realPct, 12 + minRatio * 84);
                  if (cappedTarget > 96) cappedTarget = 96;
                }

                displayPct += (Math.max(displayPct, cappedTarget) - displayPct) * 0.16;
                if (cappedTarget >= 100 && displayPct > 98.6) {
                  displayPct = 100;
                }

                if (pctEl) pctEl.textContent = String(Math.round(displayPct)).padStart(2, '0') + '%';
                if (barEl) barEl.style.transform = 'scaleX(' + (displayPct / 100).toFixed(4) + ')';
                if (arcEl) {
                  arcEl.style.strokeDashoffset = (276.46 * (1 - displayPct / 100)).toFixed(2);
                }

                var stageIdx = displayPct >= 88 ? 3 : displayPct >= 60 ? 2 : displayPct >= 30 ? 1 : 0;
                if (stageIdx !== lastStageIdx) {
                  lastStageIdx = stageIdx;
                  if (statusZhEl) statusZhEl.textContent = stagesZh[stageIdx];
                  if (statusEnEl) statusEnEl.textContent = stagesEn[stageIdx];
                }

                if (displayPct >= 99.9 && elapsed >= minDuration) {
                  finishReveal();
                  return;
                }
                requestAnimationFrame(tickPreloader);
              };

              requestAnimationFrame(tickPreloader);
            } else {
              var tier1 = document.querySelectorAll('.column__photo[src]');
              var remaining = 0;

              var onTier1Settle = function () {
                remaining -= 1;
                if (remaining <= 0) hydrateWave('1');
              };

              for (var i = 0; i < tier1.length; i++) {
                var img = tier1[i];
                if (!isReallyLoaded(img)) {
                  remaining += 1;
                  img.setAttribute('data-pending', '');
                  bindClear(img, onTier1Settle);
                }
              }

              if (remaining === 0) {
                hydrateWave('1');
              } else {
                var waitMs = window.innerWidth < 848 ? 220 : 180;
                waveTimer1 = window.setTimeout(function () {
                  hydrateWave('1');
                }, waitMs);
              }

              var scheduleSkipBg = function () {
                hydrateWave('1');
                if ('requestIdleCallback' in window) {
                  window.requestIdleCallback(function () {
                    hydrateWave('2');
                    window.__hydrateAllPanels();
                  }, { timeout: 1200 });
                } else {
                  window.setTimeout(function () {
                    hydrateWave('2');
                    window.__hydrateAllPanels();
                  }, 500);
                }
              };

              if (document.readyState === 'complete') {
                scheduleSkipBg();
              } else {
                window.addEventListener('load', scheduleSkipBg, { once: true });
              }
            }
          })();
        </script>

        <nav class="menu" aria-label="主页交互式导航">
