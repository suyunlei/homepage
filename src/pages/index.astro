---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LangToggle from '@/components/LangToggle.astro';
import BiText from '@/components/BiText.astro';
import { toAvifPath, withBase } from '@/lib/paths';
import { getLqipDataUri } from '@/lib/lqip';
import { loadSiteAndCvData } from '@/lib/site-data';

const { site } = loadSiteAndCvData();

const uniqueHomeImgs = Array.from(new Set(site.homeColumns.flatMap((col) => col.images)));
const homeLqipEntries = await Promise.all(
  uniqueHomeImgs.map(async (imgPath) => [imgPath, await getLqipDataUri(imgPath)] as const),
);
const homeLqipIndex = new Map<string, number>();
const lqipVars: string[] = [];
homeLqipEntries.forEach(([imgPath, uri], idx) => {
  if (uri) {
    homeLqipIndex.set(imgPath, idx);
    lqipVars.push(`--lqip-${idx}:url("${uri}")`);
  }
});
const homeLqipCss = lqipVars.length > 0 ? `:root{${lqipVars.join(';')}}` : '';

const panelAssets = await Promise.all(
  site.homePanels.map(async (panel) => {
    const avifPath = toAvifPath(panel.image);
    return {
      lqip: panel.imageFit === 'contain' ? '' : await getLqipDataUri(panel.image),
      avifUrl: avifPath !== panel.image ? withBase(avifPath) : '',
      webpUrl: withBase(panel.image),
    };
  }),
);

const quickLinks = [
  { label: 'Academic', href: '/academic/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Life Style', href: '/life/' },
  { label: 'Contact', href: '/contact/' },
];
---

<BaseLayout
  title={site.siteTitle}
  titleEn={site.siteTitleEn || site.siteTitle}
  description={site.siteDescription}
  bodyClass="stage-body"
>
  {homeLqipCss && <style slot="head" is:inline set:html={homeLqipCss} />}
  <main class="stage-main">
    <!-- Fixed Editorial Frame -->
    <header class="stage-frame">
      <div class="stage-frame__top">
        <div class="stage-frame__intro min-w-0 flex-1 space-y-1">
          <h1 class="stage-frame__title text-sm font-medium tracking-tight text-[#252528] sm:text-base">
            {site.heroFrameTitle}
          </h1>
          <p class="stage-frame__subtitle font-mono text-[10px] leading-relaxed uppercase tracking-[0.12em] text-[#4a4f57] sm:text-[11px] sm:tracking-[0.14em]">
            <span data-i18n="zh">{site.owner.nameZh} · {site.heroFrameSubtitle}</span>
            <span data-i18n="en">{site.owner.nameEn} · {site.heroFrameSubtitleEn || site.heroFrameSubtitle}</span>
          </p>
        </div>

        <div class="stage-frame__actions ml-auto flex shrink-0 items-center gap-4 sm:gap-6">
          <nav
            class="stage-frame__links pointer-events-auto flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-medium tracking-wide text-[#252528]"
            aria-label="快速入口"
          >
            {
              quickLinks.map((link) => (
                <a
                  href={withBase(link.href)}
                  class="border-b border-transparent pb-0.5 transition-colors hover:border-[#252528]"
                >
                  {link.label}
                </a>
              ))
            }
          </nav>

          <LangToggle />
        </div>
      </div>
    </header>

    <!-- Second Layer: Split-Screen Editorial Previews -->
    <section class="content--second" aria-label="板块预览详情">
      {
        site.homePanels.map((panel, index) => {
          const media = panelAssets[index];
          return (
            <article class="stage-item" data-panel-index={index}>
              <div
                class:list={[
                  'stage-item__img',
                  panel.imageFit === 'contain' && 'stage-item__img--contain',
                ]}
                style={
                  panel.imageFit === 'contain'
                    ? panel.imageBg
                      ? `background-color: ${panel.imageBg};`
                      : undefined
                    : media.lqip
                      ? `background-image: url("${media.lqip}"); background-size: cover; background-position: center;`
                      : undefined
                }
                aria-hidden="true"
              >
                <picture class="stage-item__picture">
                  {media.avifUrl && <source type="image/avif" data-srcset={media.avifUrl} />}
                  <img
                    data-src={media.webpUrl}
                    alt=""
                    decoding="async"
                    class:list={[
                      'stage-item__photo',
                      panel.imageFit === 'contain' && 'stage-item__photo--contain',
                    ]}
                    data-pending=""
                  />
                </picture>
              </div>
            <div class="stage-item__content">
              <button type="button" class="stage-back">
                <BiText zh="← 返回" en="← back" />
              </button>
              <p class="mt-5 font-mono text-xs uppercase tracking-[0.2em] text-[#4a4f57]">
                0{index + 1} / {panel.menuLabel}
              </p>
              <h2 class="stage-title">
                <span class="stage-title__zh" data-i18n="zh">{panel.title}</span>
                <span class="stage-title__en" data-i18n="en">{panel.titleEn || panel.title}</span>
              </h2>
              <h3 class="stage-subtitle">
                <BiText zh={panel.subtitle} en={panel.subtitleEn || panel.subtitle} />
              </h3>
              <div class="stage-text" data-i18n="zh">
                {panel.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
              <div class="stage-text" data-i18n="en">
                {(panel.paragraphsEn && panel.paragraphsEn.length > 0 ? panel.paragraphsEn : panel.paragraphs).map((p) => (
                  <p>{p}</p>
                ))}
              </div>
              <div class="mt-8">
                <a href={withBase(panel.ctaHref)} class="editorial-btn editorial-btn--primary">
                  <BiText zh={panel.ctaLabel} en={panel.ctaLabelEn || panel.ctaLabel} />
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </article>
          );
        })
      }
    </section>

    <!-- First Layer: Parallax Photo Mosaic + Kinetic Outlined Menu -->
    <section class="content--first" aria-label="主视觉导航幕布">
      <div class="content__move">
        <div class="columns" aria-hidden="true">
          {
            site.homeColumns.map((col, colIdx) => {
              const isDesktopOnlyCol = colIdx >= 4;
              return (
                <div
                  class:list={['column', col.bottom && 'column--bottom']}
                  data-desktop-only={isDesktopOnlyCol ? '1' : undefined}
                >
                  {col.images.map((imgPath, imgIdx) => {
                    const len = col.images.length;
                    const isTier1 = !isDesktopOnlyCol && (col.bottom ? imgIdx >= len - 2 : imgIdx < 2);
                    const isWave1 = isDesktopOnlyCol
                      ? col.bottom
                        ? imgIdx >= len - 4
                        : imgIdx < 4
                      : col.bottom
                        ? imgIdx >= len - 4 && imgIdx < len - 2
                        : imgIdx >= 2 && imgIdx < 4;
                    const lqipIdx = homeLqipIndex.get(imgPath);
                    const avifPath = toAvifPath(imgPath);
                    return (
                      <div
                        class="column__img"
                        style={lqipIdx !== undefined ? `background-image: var(--lqip-${lqipIdx});` : undefined}
                      >
                        <picture class="column__picture">
                          {avifPath !== imgPath &&
                            (isTier1 ? (
                              <source type="image/avif" srcset={withBase(avifPath)} />
                            ) : (
                              <source type="image/avif" data-srcset={withBase(avifPath)} />
                            ))}
                          {isTier1 ? (
                            <img
                              src={withBase(imgPath)}
                              alt=""
                              loading="eager"
                              decoding="async"
                              fetchpriority="high"
                              class="column__photo"
                            />
                          ) : (
                            <img
                              data-src={withBase(imgPath)}
                              data-wave={isWave1 ? '1' : '2'}
                              alt=""
                              decoding="async"
                              fetchpriority="low"
                              class="column__photo"
                              data-pending=""
                            />
                          )}
                        </picture>
                      </div>
                    );
                  })}
                </div>
              );
            })
          }
        </div>

        <script is:inline>
          (function () {
            var tier1 = document.querySelectorAll('.column__photo[src]');
            var remaining = 0;
            var doneWaves = { '1': false, '2': false };
            var doneDesktopWaves = { '1': false, '2': false };
            var waveTimer1 = 0;
            var tier1ReadyDispatched = false;

            function markLoaded(el) {
              el.removeAttribute('data-pending');
            }

            function bindClear(el, onSettle) {
              var settled = false;
              var finish = function () {
                if (settled) return;
                settled = true;
                markLoaded(el);
                if (onSettle) onSettle();
              };
              el.addEventListener('load', finish, { once: true });
              el.addEventListener('error', finish, { once: true });
              if (el.complete) finish();
            }

            function emitTier1Ready() {
              if (tier1ReadyDispatched) return;
              tier1ReadyDispatched = true;
              window.dispatchEvent(new Event('home-tier1-ready'));
            }

            function hydrateWave(wave, forceDesktop) {
              var desktopNow = Boolean(forceDesktop) || window.innerWidth >= 848;
              if (doneWaves[wave] && (!desktopNow || doneDesktopWaves[wave])) return;
              doneWaves[wave] = true;
              if (desktopNow) doneDesktopWaves[wave] = true;

              if (wave === '1') {
                if (waveTimer1) {
                  clearTimeout(waveTimer1);
                  waveTimer1 = 0;
                }
                emitTier1Ready();
              }

              var targets = document.querySelectorAll('.column__photo[data-wave="' + wave + '"][data-src]');
              for (var i = 0; i < targets.length; i++) {
                var img = targets[i];
                var colEl = img.closest('.column');
                if (!desktopNow && colEl && colEl.getAttribute('data-desktop-only') === '1') {
                  continue;
                }
                var url = img.getAttribute('data-src');
                if (!url) continue;
                var pic = img.parentElement;
                if (pic && pic.tagName === 'PICTURE') {
                  var sources = pic.querySelectorAll('source[data-srcset]');
                  for (var j = 0; j < sources.length; j++) {
                    var sUrl = sources[j].getAttribute('data-srcset');
                    if (sUrl) {
                      sources[j].setAttribute('srcset', sUrl);
                      sources[j].removeAttribute('data-srcset');
                    }
                  }
                }
                img.removeAttribute('data-src');
                bindClear(img, null);
                img.setAttribute('src', url);
                if (img.complete) markLoaded(img);
              }
            }

            window.__hydrateHomeWall = function () {
              hydrateWave('1');
              hydrateWave('2');
            };

            function onResizeWide() {
              if (window.innerWidth >= 848) {
                hydrateWave('1', true);
                hydrateWave('2', true);
                window.removeEventListener('resize', onResizeWide);
              }
            }
            if (window.innerWidth < 848) {
              window.addEventListener('resize', onResizeWide, { passive: true });
            }

            function onTier1Settle() {
              remaining -= 1;
              if (remaining <= 0) hydrateWave('1');
            }

            for (var i = 0; i < tier1.length; i++) {
              var img = tier1[i];
              if (!img.complete) {
                remaining += 1;
                img.setAttribute('data-pending', '');
                bindClear(img, onTier1Settle);
              }
            }

            if (remaining === 0) {
              hydrateWave('1');
            } else {
              var waitMs = window.innerWidth < 848 ? 220 : 180;
              waveTimer1 = window.setTimeout(function () {
                hydrateWave('1');
              }, waitMs);
            }

            var scheduleWave2 = function () {
              hydrateWave('1');
              if ('requestIdleCallback' in window) {
                window.requestIdleCallback(function () {
                  hydrateWave('2');
                }, { timeout: 1200 });
              } else {
                window.setTimeout(function () {
                  hydrateWave('2');
                }, 600);
              }
            };

            if (document.readyState === 'complete') {
              scheduleWave2();
            } else {
              window.addEventListener('load', scheduleWave2, { once: true });
            }
          })();
        </script>

        <nav class="menu" aria-label="主页交互式导航">
          {
            site.homePanels.map((panel, index) => (
              <button
                type="button"
                class="menu__item menu-stroke-text"
                data-menu-index={index}
              >
                {panel.menuLabel}
              </button>
            ))
          }
        </nav>
      </div>
    </section>
  </main>

  <script>
    import '../scripts/home-stage';
  </script>
</BaseLayout>

<style>
  :global(body.stage-body) {
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  .stage-main {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    display: grid;
    grid-template-columns: 100%;
    grid-template-rows: 100%;
    overflow: hidden;
  }

  .stage-frame {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
    padding: 1.5rem 1.5rem;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  @media (min-width: 53em) {
    .stage-frame {
      padding: 2.25rem 3.5rem;
    }
  }

  @media (max-width: 52.99em) {
    .stage-frame {
      padding: 0.9rem 1rem;
    }

    .stage-frame__title {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .stage-frame__links {
      display: none;
    }

    :global(body.stage-panel-open) .stage-frame {
      opacity: 0;
      pointer-events: none;
    }
  }

  .stage-frame__top {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  :global(body.stage-panel-open) .stage-frame__links {
    opacity: 0;
    pointer-events: none;
  }

  .stage-frame__links {
    transition: opacity 0.25s ease;
  }

  .content--first,
  .content__move {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    display: grid;
    grid-template-columns: 100%;
    grid-template-rows: 100%;
    align-items: center;
    justify-items: center;
    grid-area: 1 / 1 / 2 / 2;
    position: relative;
  }

  .content--first {
    position: fixed;
    inset: 0;
    z-index: 20;
    overflow: hidden;
  }

  .content__move {
    background: var(--bg-slate);
  }

  .columns {
    grid-area: 1 / 1 / 2 / 2;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: 100%;
    gap: 0.875rem;
    padding: 0 4vw;
  }

  .column {
    position: relative;
    align-self: start;
    will-change: transform;
  }

  .column--bottom {
    align-self: end;
  }

  @keyframes stage-col-top {
    from {
      opacity: 0.6;
      transform: translate3d(0, -22px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes stage-col-bottom {
    from {
      opacity: 0.6;
      transform: translate3d(0, 22px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes stage-menu-in {
    from {
      opacity: 0;
      transform: translate3d(0, 18px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .column {
      animation: stage-col-top 0.72s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }

    .column--bottom {
      animation-name: stage-col-bottom;
    }

    .column:nth-child(2) {
      animation-delay: 0.04s;
    }

    .column:nth-child(3) {
      animation-delay: 0.08s;
    }

    .column:nth-child(4) {
      animation-delay: 0.12s;
    }

    .column:nth-child(5) {
      animation-delay: 0.16s;
    }

    .column:nth-child(6) {
      animation-delay: 0.2s;
    }

    .menu__item {
      animation: stage-menu-in 0.62s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }

    .menu__item:nth-child(2) {
      animation-delay: 0.04s;
    }

    .menu__item:nth-child(3) {
      animation-delay: 0.08s;
    }

    .menu__item:nth-child(4) {
      animation-delay: 0.12s;
    }

    .menu__item:nth-child(5) {
      animation-delay: 0.16s;
    }
  }

  .column__img {
    width: 100%;
    display: block;
    opacity: 0.42;
    background-color: rgba(37, 37, 40, 0.08);
    background-size: cover;
    background-position: center;
    height: clamp(140px, 15vw, 235px);
    border-radius: 2px;
    overflow: hidden;
  }

  .column__img:nth-child(odd) {
    height: clamp(170px, 18.5vw, 285px);
  }

  .column__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .column__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.4s ease-out;
  }

  .column__photo[data-pending] {
    opacity: 0;
  }

  .column__img:not(:last-child) {
    margin-bottom: 0.875rem;
  }

  @media (max-width: 52.99em) {
    .columns {
      grid-template-columns: repeat(4, 1fr);
      padding: 0 2.5vw;
      gap: 0.625rem;
    }

    .column:nth-child(n + 5) {
      display: none;
    }

    .column__img {
      height: clamp(165px, 24vw, 380px);
    }

    .column__img:nth-child(odd) {
      height: clamp(195px, 29vw, 460px);
    }

    .column__img:not(:last-child) {
      margin-bottom: 0.625rem;
    }
  }

  .menu {
    grid-area: 1 / 1 / 2 / 2;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    padding: 3.5rem 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 53em) {
    .menu {
      padding: 6rem 1.5rem 2.5rem;
    }
  }

  .menu__item {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    padding: 0.15rem 0.5rem 0.4rem;
    font-weight: 800;
    font-size: clamp(2.25rem, 11vw, 3.8rem);
    line-height: 1.06;
    cursor: pointer;
    letter-spacing: -0.02em;
  }

  @media (min-width: 53em) {
    .menu__item {
      font-size: clamp(2.8rem, 10vh, 6.8rem);
    }
  }

  .content--second {
    grid-area: 1 / 1 / 2 / 2;
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    z-index: 10;
  }

  .stage-item {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    background: var(--bg-slate);
  }

  .stage-item.is-current {
    opacity: 1;
    pointer-events: auto;
    z-index: 5;
  }

  .stage-item__img {
    position: relative;
    height: 34vh;
    min-height: 210px;
    width: 100%;
    flex: none;
    background-color: rgba(37, 37, 40, 0.08);
    opacity: 0.9;
    overflow: hidden;
  }

  .stage-item__img--contain {
    opacity: 0.98;
  }

  .stage-item__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .stage-item__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
    display: block;
    transition: opacity 0.35s ease-out;
  }

  .stage-item__photo--contain {
    object-fit: contain;
    object-position: 50% 50%;
    padding: 1rem 1.25rem;
  }

  .stage-item__photo[data-pending] {
    opacity: 0;
  }

  @media (max-width: 52.99em) {
    .stage-item__img--contain {
      height: 30vh;
      min-height: 175px;
    }
  }

  .stage-item__content {
    flex: 1;
    overflow-y: auto;
    padding: 1.75rem 1.5rem 3rem;
  }

  .stage-back {
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink-primary);
    letter-spacing: 0.04em;
    transition: opacity 0.2s ease;
  }

  .stage-back:hover {
    opacity: 0.65;
  }

  .stage-title {
    margin: 0.5rem 0 0;
    font-size: clamp(2.1rem, 5vw, 4.4rem);
    font-weight: 700;
    line-height: 1.12;
    color: var(--ink-primary);
  }

  .stage-subtitle {
    margin: 0.5rem 0 0;
    font-size: clamp(1.05rem, 1.8vw, 1.5rem);
    font-weight: 400;
    color: var(--ink-secondary);
  }

  .stage-text {
    margin-top: 2rem;
    max-width: 36rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--ink-primary);
  }

  @media (min-width: 53em) {
    .stage-item {
      flex-direction: row;
    }

    .stage-item__img {
      height: 100%;
      width: 44%;
    }

    .stage-item__photo {
      object-position: 50% 50%;
    }

    .stage-item__content {
      padding: 7.5rem 7vw 3rem 6vw;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
    }
  }
</style>
