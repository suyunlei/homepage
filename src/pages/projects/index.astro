---
import { getCollection } from 'astro:content';
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import { isExternalHref, withBase } from '@/lib/paths';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const categories = Array.from(new Set(projects.map((p) => p.data.category)));
---

<EditorialLayout
  title="实践项目 · Projects · 苏云雷"
  description="苏云雷（Yunlei Su）的研究工程与开发实践项目：WebGIS、专题地图制图、遥感城市扩张分析与前端作品。"
>
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <header class="reveal-section border-b editorial-hairline pb-8">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#4a4f57]">
        Projects · 实践与创造
      </p>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight text-[#252528] sm:text-4xl">
            可视化自己的进步
          </h1>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[#4a4f57] sm:text-base">
            记录在空间信息工程、地图制图、科研分析与早期前端实习中创造的项目与思考。
          </p>
        </div>
        <span class="font-mono text-xs text-[#4a4f57]">
          Showing <strong id="project-visible-count">{projects.length}</strong> / {projects.length}
        </span>
      </div>

      <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="按项目类型筛选">
        <button
          type="button"
          class="editorial-pill cursor-pointer hover:border-[#252528]"
          data-project-filter="all"
          aria-pressed="true"
        >
          All
        </button>
        {
          categories.map((cat) => (
            <button
              type="button"
              class="editorial-pill cursor-pointer hover:border-[#252528]"
              data-project-filter={cat}
              aria-pressed="false"
            >
              {cat}
            </button>
          ))
        }
      </div>
    </header>

    <section class="reveal-section mt-10 grid gap-6 md:grid-cols-2">
      {
        projects.map((project) => {
          const { data } = project;
          return (
            <article
              class="project-card group editorial-card flex flex-col overflow-hidden rounded-2xl transition-colors hover:border-[#252528]/35"
              data-project-category={data.category}
            >
              <div class="relative aspect-[16/10] overflow-hidden bg-[#9ea6ad]/40">
                <img
                  src={withBase(data.cover)}
                  alt={data.title}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <span class="absolute top-3 left-3 rounded-full bg-[#252528]/85 px-3 py-1 font-mono text-[11px] text-[#f4f6f8] backdrop-blur-sm">
                  {data.category}
                </span>
              </div>

              <div class="flex flex-1 flex-col p-6">
                <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-[#5d636c]">
                  <span>{data.organization}</span>
                  <span>{data.date}</span>
                </div>

                <h2 class="mt-2.5 text-xl font-bold tracking-tight text-[#252528]">
                  {data.title}
                </h2>
                {data.subtitle && (
                  <p class="mt-0.5 text-xs font-medium text-[#27445d]">{data.subtitle}</p>
                )}

                <p class="mt-3 text-sm leading-relaxed text-[#4a4f57]">{data.summary}</p>

                {data.highlights.length > 0 && (
                  <ul class="mt-4 space-y-1.5 text-xs leading-relaxed text-[#252528]/85">
                    {data.highlights.map((item) => (
                      <li class="flex gap-2">
                        <span class="font-mono text-[#27445d]">—</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}

                <div class="mt-5 flex flex-wrap gap-1.5">
                  {data.tags.map((tag) => (
                    <span class="rounded-md bg-[#252528]/[0.06] px-2 py-0.5 font-mono text-[11px] text-[#4a4f57]">
                      {tag}
                    </span>
                  ))}
                </div>

                <div class="mt-auto pt-5">
                  {data.links.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                      {data.links.map((link) => {
                        const openNew = link.kind === 'pdf' || isExternalHref(link.href);
                        return (
                          <a
                            href={withBase(link.href)}
                            target={openNew ? '_blank' : undefined}
                            rel={openNew ? 'noopener noreferrer' : undefined}
                            class:list={[
                              'editorial-pill',
                              link.kind === 'pdf'
                                ? 'bg-[#27445d] text-[#f4f6f8] border-[#27445d] hover:bg-[#1b3144]'
                                : 'hover:border-[#252528]',
                            ]}
                          >
                            <span>{link.label}</span>
                            <span aria-hidden="true">{openNew ? '↗' : '→'}</span>
                          </a>
                        );
                      })}
                    </div>
                  )}

                  {data.archiveNote && (
                    <p class="mt-3 rounded-xl border border-[#252528]/12 bg-white/35 px-3 py-2 font-mono text-[11px] text-[#5d636c]">
                      {data.archiveNote}
                    </p>
                  )}
                </div>
              </div>
            </article>
          );
        })
      }
    </section>

    <section class="reveal-section editorial-card mt-12 rounded-2xl p-6 text-center sm:p-8">
      <p class="text-sm text-[#4a4f57]">
        要做与记录的东西还会有很多。如果想查看学术论文全文与引用格式，可以前往学术成果空间：
      </p>
      <div class="mt-4">
        <a href={withBase('/academic/#publications')} class="editorial-btn editorial-btn--primary">
          进入学术论文列表 →
        </a>
      </div>
    </section>
  </div>

  <script>
    import '../../scripts/projects';
  </script>
</EditorialLayout>
