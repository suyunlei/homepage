---
import { getCollection } from 'astro:content';
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import BiText from '@/components/BiText.astro';
import { isExternalHref, withBase } from '@/lib/paths';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const categories = Array.from(new Set(projects.map((p) => p.data.category)));
---

<EditorialLayout
  title="实践项目与播客 · Projects · 苏云雷"
  titleEn="Projects & Podcast · Yunlei Su"
  description="苏云雷（Yunlei Su）的独立产品、课题组官网、播客与工程实践：阿薄/薄迹 BOJI、Urban Morphology Studio (UMS) 官网、小宇宙播客《待会儿再说》、三河湿地 WebGIS 与企业前端工程。"
>
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <header class="reveal-section border-b editorial-hairline pb-8">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#4a4f57]">
        <BiText zh="Projects & Media · 实践、创造与发声" en="Projects & Media" />
      </p>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight text-[#252528] sm:text-4xl">
            <BiText zh="可视化自己的进步" en="Building, Thinking & Hosting" />
          </h1>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[#4a4f57] sm:text-base">
            <BiText
              zh="记录从独立产品全栈落地、Urban Morphology Studio (UMS) 课题组官网、小宇宙播客《待会儿再说》、空间信息平台研发到企业级前端工程实践中的代表作品。"
              en={'Selected works across full-stack indie products (BOJI), the Urban Morphology Studio (UMS) website, my Xiaoyuzhou podcast "Talk Later" (《待会儿再说》), WebGIS platforms, and enterprise web engineering.'}
            />
          </p>
        </div>
        <span class="font-mono text-xs text-[#4a4f57]">
          Showing <strong id="project-visible-count">{projects.length}</strong> / {projects.length}
        </span>
      </div>

      <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="按项目类型筛选">
        <button
          type="button"
          class="editorial-pill cursor-pointer hover:border-[#252528]"
          data-project-filter="all"
          aria-pressed="true"
        >
          All
        </button>
        {
          categories.map((cat) => (
            <button
              type="button"
              class="editorial-pill cursor-pointer hover:border-[#252528]"
              data-project-filter={cat}
              aria-pressed="false"
            >
              {cat}
            </button>
          ))
        }
      </div>
    </header>

    <section class="reveal-section mt-10 grid gap-6 md:grid-cols-2">
      {
        projects.map((project) => {
          const { data } = project;
          if (data.featured) {
            return (
              <article
                class="project-card group editorial-card md:col-span-2 grid overflow-hidden rounded-3xl transition-colors hover:border-[#252528]/35 lg:grid-cols-12"
                data-project-category={data.category}
              >
                <div class="flex flex-col items-center justify-center gap-4 border-b editorial-hairline bg-[#f4eee6] p-6 sm:p-8 lg:col-span-5 lg:border-r lg:border-b-0">
                  <div class="overflow-hidden rounded-[28px] border-[6px] border-[#252528] bg-[#f8f3ec] shadow-xl">
                    <img
                      src={withBase(data.cover)}
                      alt={data.title}
                      loading="eager"
                      decoding="async"
                      fetchpriority="high"
                      class="max-h-[440px] w-auto object-contain transition-transform duration-500 group-hover:scale-[1.02]"
                    />
                  </div>
                  {(data.badgeImage || data.miniProgramName) && (
                    <div class="flex flex-wrap items-center justify-center gap-3 rounded-2xl border border-[#252528]/12 bg-white/95 px-4 py-2.5 shadow-sm">
                      {data.badgeImage && (
                        <img
                          src={withBase(data.badgeImage)}
                          alt={data.miniProgramName || data.title}
                          loading="lazy"
                          decoding="async"
                          class="h-8 w-auto object-contain"
                        />
                      )}
                      {data.miniProgramName && (
                        <span class="font-mono text-xs text-[#252528]">
                          <BiText
                            zh={`微信小程序搜「${data.miniProgramName}」`}
                            en={`WeChat Mini Program: ${data.miniProgramName}`}
                          />
                        </span>
                      )}
                    </div>
                  )}
                </div>

                <div class="flex flex-col justify-center p-6 sm:p-8 lg:col-span-7 lg:p-10">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class="rounded-full bg-[#27445d] px-3 py-1 font-mono text-[11px] uppercase tracking-wider text-[#f4f6f8]">
                      Flagship · {data.category}
                    </span>
                    <div class="flex items-center gap-3 font-mono text-xs text-[#5d636c]">
                      <span>
                        <BiText zh={data.organization} en={data.organizationEn || data.organization} />
                      </span>
                      <span>·</span>
                      <span>{data.date}</span>
                    </div>
                  </div>

                  <h2 class="mt-4 text-2xl font-bold tracking-tight text-[#252528] sm:text-3xl">
                    <BiText zh={data.title} en={data.titleEn || data.title} />
                  </h2>
                  {data.subtitle && (
                    <p class="mt-1 text-sm font-medium text-[#27445d]">
                      <BiText zh={data.subtitle} en={data.subtitleEn || data.subtitle} />
                    </p>
                  )}

                  <p class="mt-4 text-sm leading-relaxed text-[#4a4f57] sm:text-base">
                    <BiText zh={data.summary} en={data.summaryEn || data.summary} />
                  </p>

                  {data.highlights.length > 0 && (
                    <>
                      <ul class="mt-5 space-y-2 text-sm leading-relaxed text-[#252528]/90" data-i18n="zh">
                        {data.highlights.map((item) => (
                          <li class="flex gap-2.5">
                            <span class="font-mono text-[#27445d]">—</span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                      <ul class="mt-5 space-y-2 text-sm leading-relaxed text-[#252528]/90" data-i18n="en">
                        {(data.highlightsEn.length > 0 ? data.highlightsEn : data.highlights).map((item) => (
                          <li class="flex gap-2.5">
                            <span class="font-mono text-[#27445d]">—</span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </>
                  )}

                  <div class="mt-5 flex flex-wrap gap-1.5">
                    {data.tags.map((tag) => (
                      <span class="rounded-md bg-[#252528]/[0.06] px-2.5 py-0.5 font-mono text-[11px] text-[#4a4f57]">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <div class="mt-6 flex flex-wrap items-center gap-3">
                    {data.links.map((link) => {
                      const openNew = link.kind === 'pdf' || isExternalHref(link.href);
                      return (
                        <a
                          href={withBase(link.href)}
                          target={openNew ? '_blank' : undefined}
                          rel={openNew ? 'noopener noreferrer' : undefined}
                          class="editorial-btn editorial-btn--primary"
                        >
                          <BiText zh={link.label} en={link.labelEn || link.label} />
                          <span aria-hidden="true">{openNew ? '↗' : '→'}</span>
                        </a>
                      );
                    })}
                    {data.miniProgramName && (
                      <span class="rounded-full border border-[#252528]/20 bg-white/60 px-3.5 py-2 font-mono text-xs text-[#252528]">
                        <BiText zh={`微信入口：${data.miniProgramName}`} en={`WeChat: ${data.miniProgramName}`} />
                      </span>
                    )}
                  </div>
                </div>
              </article>
            );
          }

          const isContain = data.coverFit === 'contain';
          return (
            <article
              class="project-card group editorial-card flex flex-col overflow-hidden rounded-2xl transition-colors hover:border-[#252528]/35"
              data-project-category={data.category}
            >
              <div
                class:list={[
                  'relative aspect-[16/10] overflow-hidden',
                  !isContain && 'bg-[#9ea6ad]/40',
                ]}
                style={isContain && data.coverBg ? `background-color: ${data.coverBg};` : undefined}
              >
                <img
                  src={withBase(data.cover)}
                  alt={data.title}
                  loading="lazy"
                  decoding="async"
                  class:list={[
                    'h-full w-full transition-transform duration-500',
                    isContain
                      ? 'object-contain p-3 group-hover:scale-[1.03]'
                      : 'object-cover group-hover:scale-105',
                  ]}
                />
                <span class="absolute top-3 left-3 rounded-full bg-[#252528]/85 px-3 py-1 font-mono text-[11px] text-[#f4f6f8] backdrop-blur-sm">
                  <BiText zh={data.category} en={data.categoryEn || data.category} />
                </span>
              </div>

              <div class="flex flex-1 flex-col p-6">
                <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-[#5d636c]">
                  <span>
                    <BiText zh={data.organization} en={data.organizationEn || data.organization} />
                  </span>
                  <span>{data.date}</span>
                </div>

                <h2 class="mt-2.5 text-xl font-bold tracking-tight text-[#252528]">
                  <BiText zh={data.title} en={data.titleEn || data.title} />
                </h2>
                {data.subtitle && (
                  <p class="mt-0.5 text-xs font-medium text-[#27445d]">
                    <BiText zh={data.subtitle} en={data.subtitleEn || data.subtitle} />
                  </p>
                )}

                <p class="mt-3 text-sm leading-relaxed text-[#4a4f57]">
                  <BiText zh={data.summary} en={data.summaryEn || data.summary} />
                </p>

                {data.highlights.length > 0 && (
                  <>
                    <ul class="mt-4 space-y-1.5 text-xs leading-relaxed text-[#252528]/85" data-i18n="zh">
                      {data.highlights.map((item) => (
                        <li class="flex gap-2">
                          <span class="font-mono text-[#27445d]">—</span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                    <ul class="mt-4 space-y-1.5 text-xs leading-relaxed text-[#252528]/85" data-i18n="en">
                      {(data.highlightsEn.length > 0 ? data.highlightsEn : data.highlights).map((item) => (
                        <li class="flex gap-2">
                          <span class="font-mono text-[#27445d]">—</span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </>
                )}

                <div class="mt-5 flex flex-wrap gap-1.5">
                  {data.tags.map((tag) => (
                    <span class="rounded-md bg-[#252528]/[0.06] px-2 py-0.5 font-mono text-[11px] text-[#4a4f57]">
                      {tag}
                    </span>
                  ))}
                </div>

                <div class="mt-auto pt-5">
                  {data.platformBadge && (
                    <p class="inline-flex items-center gap-2 rounded-full border border-[#27445d]/30 bg-[#27445d]/10 px-3.5 py-1.5 font-mono text-xs font-medium text-[#27445d]">
                      <BiText zh={data.platformBadge} en={data.platformBadgeEn || data.platformBadge} />
                    </p>
                  )}

                  {data.links.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                      {data.links.map((link) => {
                        const openNew = link.kind === 'pdf' || isExternalHref(link.href);
                        return (
                          <a
                            href={withBase(link.href)}
                            target={openNew ? '_blank' : undefined}
                            rel={openNew ? 'noopener noreferrer' : undefined}
                            class:list={[
                              'editorial-pill',
                              link.kind === 'pdf'
                                ? 'bg-[#27445d] text-[#f4f6f8] border-[#27445d] hover:bg-[#1b3144]'
                                : 'hover:border-[#252528]',
                            ]}
                          >
                            <BiText zh={link.label} en={link.labelEn || link.label} />
                            <span aria-hidden="true">{openNew ? '↗' : '→'}</span>
                          </a>
                        );
                      })}
                    </div>
                  )}

                  {data.archiveNote && (
                    <p class="mt-3 rounded-xl border border-[#252528]/12 bg-white/35 px-3 py-2 font-mono text-[11px] text-[#5d636c]">
                      <BiText zh={data.archiveNote} en={data.archiveNoteEn || data.archiveNote} />
                    </p>
                  )}
                </div>
              </div>
            </article>
          );
        })
      }
    </section>

    <section class="reveal-section editorial-card mt-12 rounded-2xl p-6 text-center sm:p-8">
      <p class="text-sm text-[#4a4f57]">
        <BiText
          zh="要做与记录的东西还会有很多。如果想查看学术论文全文与引用格式，可以前往学术成果空间："
          en="More builds and conversations are on the way. Looking for full papers, BibTeX citations, or research background?"
        />
      </p>
      <div class="mt-4">
        <a href={withBase('/academic/#publications')} class="editorial-btn editorial-btn--primary">
          <BiText zh="进入学术论文列表 →" en="Explore Academic Publications →" />
        </a>
      </div>
    </section>
  </div>

  <script>
    import '../../scripts/projects';
  </script>
</EditorialLayout>
