---
import { getCollection } from 'astro:content';
import EditorialLayout from '@/layouts/EditorialLayout.astro';
import PublicationCard from '@/components/PublicationCard.astro';
import BiText from '@/components/BiText.astro';
import { withBase } from '@/lib/paths';
import { encodeEmailForClient, loadSiteAndCvData } from '@/lib/site-data';

const { site, cv } = loadSiteAndCvData();

const publications = (await getCollection('publications')).sort(
  (a, b) => b.data.year - a.data.year || b.data.date.localeCompare(a.data.date),
);
const projects = await getCollection('projects');

const distinctYears = Array.from(new Set(publications.map((p) => p.data.year))).sort((a, b) => b - a);
const firstAuthorCount = publications.filter((p) =>
  p.data.indexing.some((tag) => /first/i.test(tag)),
).length;

const emailCodes = site.contact.email ? encodeEmailForClient(site.contact.email) : null;

const filterTypes = [
  { key: 'all', label: 'All' },
  { key: 'journal', label: 'Journal' },
  { key: 'conference', label: 'Conference' },
  { key: 'preprint', label: 'Preprint' },
  { key: 'thesis', label: 'Thesis' },
];
---

<EditorialLayout
  title={`学术成果 · ${site.owner.nameZh} (${site.owner.nameEn})`}
  titleEn={`Academic · ${site.owner.nameEn}`}
  description="苏云雷（Yunlei Su）的学术主页：研究方向、论文发表、PDF 与 BibTeX 引用、教育与科研实践履历。"
>
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <!-- Scholar Hero -->
    <section class="reveal-section grid gap-8 border-b editorial-hairline pb-12 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
          <img
            src={withBase(site.owner.avatar)}
            alt={`${site.owner.nameZh} (${site.owner.nameEn})`}
            width="96"
            height="96"
            decoding="async"
            class="h-24 w-24 rounded-full border-2 border-[#f4f6f8] object-cover shadow-md"
          />
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#4a4f57]">
              <BiText zh="Academic Profile · 学术成果空间" en="Academic Profile" />
            </p>
            <h1 class="mt-1.5 text-3xl font-bold tracking-tight text-[#252528] sm:text-4xl">
              <span data-i18n="zh">{site.owner.nameZh} · </span>{site.owner.nameEn}
            </h1>
            <p class="mt-1.5 text-base font-medium text-[#27445d]">
              <BiText zh={cv.position} en={cv.positionEn || cv.position} />
            </p>
            <p class="mt-0.5 text-sm text-[#4a4f57]">
              <BiText zh={cv.affiliation} en={cv.affiliationEn || cv.affiliation} />
            </p>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-2.5">
          <a href="#publications" class="editorial-btn editorial-btn--primary">
            <BiText zh="论文列表 ↓" en="Publications ↓" />
          </a>
          {
            cv.cvPdf && (
              <a
                href={withBase(cv.cvPdf)}
                target="_blank"
                rel="noopener noreferrer"
                class="editorial-btn"
              >
                CV (PDF) ↗
              </a>
            )
          }
          {
            site.contact.githubUrl && (
              <a
                href={site.contact.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="editorial-btn"
              >
                GitHub ↗
              </a>
            )
          }
          {
            site.contact.scholarUrl && (
              <a
                href={site.contact.scholarUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="editorial-btn"
              >
                Google Scholar ↗
              </a>
            )
          }
          {
            site.contact.orcidUrl && (
              <a
                href={site.contact.orcidUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="editorial-btn"
              >
                ORCID ↗
              </a>
            )
          }
          {
            emailCodes ? (
              <button
                type="button"
                id="academic-email-btn"
                class="editorial-btn"
                data-email-codes={JSON.stringify(emailCodes)}
              >
                <BiText zh="显示学术邮箱" en="Reveal Academic Email" />
              </button>
            ) : (
              <a href={withBase('/contact/')} class="editorial-btn">
                <BiText zh="联系交流 →" en="Contact →" />
              </a>
            )
          }
        </div>
      </div>

      <!-- Metrics Panel -->
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:col-span-5 lg:grid-cols-2">
        <div class="editorial-card rounded-2xl p-4">
          <p class="font-mono text-[11px] uppercase tracking-wider text-[#5d636c]">Publications</p>
          <p class="mt-2 text-2xl font-bold text-[#252528]">{publications.length}</p>
        </div>
        <div class="editorial-card rounded-2xl p-4">
          <p class="font-mono text-[11px] uppercase tracking-wider text-[#5d636c]">First / Co-First</p>
          <p class="mt-2 text-2xl font-bold text-[#252528]">{firstAuthorCount}</p>
        </div>
        <div class="editorial-card rounded-2xl p-4">
          <p class="font-mono text-[11px] uppercase tracking-wider text-[#5d636c]">Research Areas</p>
          <p class="mt-2 text-2xl font-bold text-[#252528]">{cv.researchInterests.length}</p>
        </div>
        <div class="editorial-card rounded-2xl p-4">
          <p class="font-mono text-[11px] uppercase tracking-wider text-[#5d636c]">Projects</p>
          <p class="mt-2 text-2xl font-bold text-[#252528]">{projects.length}</p>
        </div>
      </div>
    </section>

    <!-- Section 01: Research Bio & Directions -->
    <section id="about" class="reveal-section mt-14 scroll-mt-24">
      <div class="flex items-baseline justify-between gap-4 border-b editorial-hairline pb-3">
        <h2 class="text-xl font-bold tracking-tight text-[#252528] sm:text-2xl">
          <BiText zh="01 / 研究简介与方向 · Research Profile" en="01 / Research Profile" />
        </h2>
        <span class="font-mono text-xs uppercase tracking-wider text-[#5d636c]">Overview</span>
      </div>

      <div class="mt-6 space-y-3 text-base leading-relaxed text-[#252528]/90" data-i18n="zh">
        {cv.bioParagraphs.map((para) => <p>{para}</p>)}
      </div>
      <div class="mt-6 space-y-3 text-base leading-relaxed text-[#252528]/90" data-i18n="en">
        {(cv.bioParagraphsEn && cv.bioParagraphsEn.length > 0 ? cv.bioParagraphsEn : cv.bioParagraphs).map((para) => (
          <p>{para}</p>
        ))}
      </div>

      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {
          cv.researchInterests.map((item) => (
            <div class="editorial-card rounded-2xl p-5 sm:p-6">
              <div class="flex items-center justify-between gap-3">
                <span class="font-mono text-xs font-semibold tracking-widest text-[#27445d]">
                  {item.code}
                </span>
                <span class="text-xs text-[#5d636c]" data-i18n="zh">{item.titleZh}</span>
              </div>
              <h3 class="mt-2 text-lg font-semibold text-[#252528]">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[#4a4f57]">
                <BiText zh={item.summary} en={item.summaryEn || item.summary} />
              </p>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {item.keywords.map((kw) => (
                  <span class="rounded-md bg-[#252528]/[0.06] px-2 py-0.5 font-mono text-[11px] text-[#4a4f57]">
                    {kw}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Section 02: Publications -->
    <section id="publications" class="reveal-section mt-16 scroll-mt-24">
      <div class="flex flex-wrap items-baseline justify-between gap-4 border-b editorial-hairline pb-3">
        <h2 class="text-xl font-bold tracking-tight text-[#252528] sm:text-2xl">
          <BiText zh="02 / 学术论文与成果 · Publications" en="02 / Publications" />
        </h2>
        <span class="font-mono text-xs text-[#4a4f57]">
          Showing <strong id="pub-visible-count">{publications.length}</strong> of {publications.length}
        </span>
      </div>

      <!-- Filter Toolbar -->
      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-wrap gap-2" role="group" aria-label="按成果类型筛选">
          {
            filterTypes.map((ft, idx) => (
              <button
                type="button"
                class="editorial-pill cursor-pointer hover:border-[#252528]"
                data-filter-type={ft.key}
                aria-pressed={idx === 0 ? 'true' : 'false'}
              >
                {ft.label}
              </button>
            ))
          }
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <label class="sr-only" for="pub-year-select">筛选年份</label>
          <select
            id="pub-year-select"
            class="rounded-full border editorial-hairline bg-white/55 px-3.5 py-1.5 font-mono text-xs text-[#252528] outline-none focus:border-[#252528]"
          >
            <option value="all">All Years</option>
            {distinctYears.map((y) => <option value={String(y)}>{y}</option>)}
          </select>

          <label class="sr-only" for="pub-search-input">搜索论文</label>
          <input
            id="pub-search-input"
            type="search"
            placeholder="按标题、作者、期刊或关键词检索..."
            data-placeholder-zh="按标题、作者、期刊或关键词检索..."
            data-placeholder-en="Search title, author, venue, keyword..."
            class="w-full rounded-full border editorial-hairline bg-white/55 px-4 py-1.5 text-sm text-[#252528] placeholder:text-[#5d636c] outline-none focus:border-[#252528] sm:w-64"
          />
        </div>
      </div>

      <div class="mt-6 space-y-4">
        {publications.map((pub) => <PublicationCard publication={pub} />)}
      </div>

      <p
        id="pub-empty-state"
        class="editorial-card mt-6 hidden rounded-2xl p-8 text-center text-sm text-[#4a4f57]"
      >
        <BiText
          zh="没有找到符合当前筛选条件的学术成果，请尝试切换类别、年份或清空搜索关键词。"
          en="No matching publications found. Try clearing filters or changing the search query."
        />
      </p>
    </section>

    <!-- Section 03: Education & Experience -->
    <section id="cv" class="reveal-section mt-16 scroll-mt-24">
      <div class="flex items-baseline justify-between gap-4 border-b editorial-hairline pb-3">
        <h2 class="text-xl font-bold tracking-tight text-[#252528] sm:text-2xl">
          <BiText zh="03 / 教育与实践履历 · Education & Experience" en="03 / Education & Experience" />
        </h2>
        <span class="font-mono text-xs uppercase tracking-wider text-[#5d636c]">Curriculum Vitae</span>
      </div>

      <div class="mt-6 grid gap-6 lg:grid-cols-2">
        <div class="space-y-4">
          <h3 class="font-mono text-xs uppercase tracking-[0.18em] text-[#4a4f57]">
            <BiText zh="Education · 教育背景" en="Education" />
          </h3>
          {
            cv.education.map((edu) => (
              <div class="editorial-card rounded-2xl p-5 sm:p-6">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class="font-mono text-xs font-semibold text-[#27445d]">{edu.period}</span>
                  <span class="font-mono text-xs text-[#5d636c]">
                    <BiText zh={edu.location} en={edu.locationEn || edu.location} />
                  </span>
                </div>
                <h4 class="mt-2 text-lg font-semibold text-[#252528]">
                  <BiText zh={edu.institution} en={edu.institutionEn || edu.institution} />
                </h4>
                <p class="mt-0.5 text-sm font-medium text-[#4a4f57]">
                  <BiText zh={edu.degree} en={edu.degreeEn || edu.degree} />
                </p>
                <p class="mt-2 text-sm leading-relaxed text-[#4a4f57]">
                  <BiText zh={edu.details} en={edu.detailsEn || edu.details} />
                </p>
              </div>
            ))
          }
        </div>

        <div class="space-y-4">
          <h3 class="font-mono text-xs uppercase tracking-[0.18em] text-[#4a4f57]">
            <BiText zh="Experience · 实习与工作经历" en="Experience" />
          </h3>
          {
            cv.experience.map((exp) => (
              <div class="editorial-card rounded-2xl p-5 sm:p-6">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class="font-mono text-xs font-semibold text-[#27445d]">{exp.period}</span>
                  <span class="font-mono text-xs text-[#5d636c]">
                    <BiText zh={exp.location} en={exp.locationEn || exp.location} />
                  </span>
                </div>
                <h4 class="mt-2 text-lg font-semibold text-[#252528]">
                  <BiText zh={exp.organization} en={exp.organizationEn || exp.organization} />
                </h4>
                <p class="mt-0.5 text-sm font-medium text-[#4a4f57]">
                  <BiText zh={exp.role} en={exp.roleEn || exp.role} />
                </p>
                {exp.details && (
                  <p class="mt-2 text-sm leading-relaxed text-[#4a4f57]">
                    <BiText zh={exp.details} en={exp.detailsEn || exp.details} />
                  </p>
                )}
                {exp.highlights && exp.highlights.length > 0 && (
                  <>
                    <ul class="mt-3 space-y-1.5 text-sm leading-relaxed text-[#4a4f57]" data-i18n="zh">
                      {exp.highlights.map((item) => (
                        <li class="flex gap-2">
                          <span class="font-mono text-[#27445d]">—</span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                    <ul class="mt-3 space-y-1.5 text-sm leading-relaxed text-[#4a4f57]" data-i18n="en">
                      {(exp.highlightsEn && exp.highlightsEn.length > 0 ? exp.highlightsEn : exp.highlights).map((item) => (
                        <li class="flex gap-2">
                          <span class="font-mono text-[#27445d]">—</span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Section 04: Selected Research Projects, Honors & Skills -->
    <section id="honors" class="reveal-section mt-16 scroll-mt-24">
      <div class="flex items-baseline justify-between gap-4 border-b editorial-hairline pb-3">
        <h2 class="text-xl font-bold tracking-tight text-[#252528] sm:text-2xl">
          <BiText zh="04 / 荣誉奖项、代表项目与技术栈 · Honors & Stack" en="04 / Honors, Projects & Stack" />
        </h2>
        <a href={withBase('/projects/')} class="font-mono text-xs text-[#27445d] hover:underline">
          <BiText zh="全部项目与播客 →" en="All Projects →" />
        </a>
      </div>

      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {
          cv.honorsAndProjects.map((item) => (
            <div class="editorial-card rounded-2xl p-5 sm:p-6">
              <span class="font-mono text-xs font-semibold text-[#27445d]">{item.year}</span>
              <h3 class="mt-1.5 text-base font-semibold text-[#252528] sm:text-lg">
                <BiText zh={item.title} en={item.titleEn || item.title} />
              </h3>
              <p class="mt-0.5 text-xs font-medium text-[#4a4f57]">
                <BiText zh={item.role} en={item.roleEn || item.role} />
              </p>
              <p class="mt-2 text-sm leading-relaxed text-[#4a4f57]">
                <BiText zh={item.note} en={item.noteEn || item.note} />
              </p>
            </div>
          ))
        }
      </div>

      <div class="editorial-card mt-6 rounded-2xl p-5 sm:p-6">
        <div class="grid gap-6 md:grid-cols-3">
          {
            cv.serviceAndSkills.map((grp) => (
              <div>
                <h3 class="font-mono text-xs uppercase tracking-[0.16em] text-[#4a4f57]">
                  {grp.group}
                </h3>
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {grp.items.map((skill) => (
                    <span class="rounded-md bg-[#252528]/[0.07] px-2.5 py-1 font-mono text-xs text-[#252528]">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <script>
    import '../../scripts/academic';
  </script>
</EditorialLayout>
